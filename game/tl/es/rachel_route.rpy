    x "Sí, a menos que las clases se pongan realmente difíciles, pero no espero que sea el caso."

# game/rachel_route.rpy:1570
translate es racheldrivecontinue3_dbad3eb9:

    # r "You were always so good at school, or whatever you put your mind to."
    r "Siempre fuiste tan bueno en la escuela, o en lo que sea que te propusieras."

# game/rachel_route.rpy:1572
translate es racheldrivecontinue3_f05ef972:

    # r "And I used to love coming to watch your football matches."
    r "Y me encantaba venir a ver tus partidos de fútbol."

# game/rachel_route.rpy:1575
translate es racheldrivecontinue3_676d16b7:

    # x "I don't really have time for football right now, as much as I'd love to."
    x "Realmente no tengo tiempo para el fútbol ahora, por mucho que me encantaría."

# game/rachel_route.rpy:1577
translate es racheldrivecontinue3_e59d9900:

    # r "But you are still in great shape, you must be doing some kind of workout to stay that fit."
    r "Pero sigues en gran forma, debes estar haciendo algún tipo de ejercicio para mantenerte tan en forma."

# game/rachel_route.rpy:1579
translate es racheldrivecontinue3_f32d35c7:

    # x "I did a lot of... let's say exercises back in the mansion."
    x "Hice mucho de... digamos ejercicios de vuelta en la mansión."

# game/rachel_route.rpy:1581
translate es racheldrivecontinue3_ce3841df:

    # "{i}~I said, feeling butterflies take off within my belly~"
    "{i}~Dije, sintiendo mariposas despegar dentro de mi vientre~"

# game/rachel_route.rpy:1592
translate es racheldrivecontinue3_b7895304:

    # r "So, what's going on with you and Linda?"
    r "Entonces, ¿qué pasa entre tú y Linda?"

# game/rachel_route.rpy:1594
translate es racheldrivecontinue3_6a3b29fd:

    # "{i}~Her tone grew tight and she stared out the window, unable to look at me~"
    "{i}~Su tono se tensó y miró por la ventana, incapaz de mirarme~"

# game/rachel_route.rpy:1596
translate es racheldrivecontinue3_34e1eea8:

    # x "Nothing [m], it was nothing serious."
    x "Nada, [m], no fue nada serio."

# game/rachel_route.rpy:1598
translate es racheldrivecontinue3_6ab98627:

    # x "Are you mad at me for what I did?"
    x "¿Estás enojada conmigo por lo que hice?"

# game/rachel_route.rpy:1601
translate es racheldrivecontinue3_001883ac:

    # r "No, not at all."
    r "No, para nada."

# game/rachel_route.rpy:1603
translate es racheldrivecontinue3_a558cb4b:

    # r "I just want you to understand that you don’t have to do anything you don’t want to… Linda wise, I mean."
    r "Solo quiero que entiendas que no tienes que hacer nada que no quieras… en cuanto a Linda, quiero decir."

# game/rachel_route.rpy:1606
translate es racheldrivecontinue3_4b9744eb:

    # r "I think this could be good for you,"
    r "Creo que esto podría ser bueno para ti,"

# game/rachel_route.rpy:1608
translate es racheldrivecontinue3_7fb33c17:

    # "{i}~An odd thoughtfulness creeping into her tone as she looked at me~"
    "{i}~Una extraña reflexión infiltrándose en su tono mientras me miraba~"

# game/rachel_route.rpy:1610
translate es racheldrivecontinue3_638f0b01:

    # r "Good for both of you."
    r "Bueno para ambos."

# game/rachel_route.rpy:1612
translate es racheldrivecontinue3_42b89e6d:

    # x "Yea, Linda is just a good friend and wants to help out."
    x "Sí, Linda es solo una buena amiga y quiere ayudar."

# game/rachel_route.rpy:1615
translate es racheldrivecontinue3_9d7a5ad7:

    # r "You think so? HaHaHa"
    r "¿Tú crees? Ja, ja, ja"

# game/rachel_route.rpy:1617
translate es racheldrivecontinue3_033606c8:

    # "{i}~Her laughter far too loud for my silly joke~"
    "{i}~Su risa demasiado fuerte para mi chiste tonto~"

# game/rachel_route.rpy:1619
translate es racheldrivecontinue3_61b7602d:

    # "{i}~I found myself trying to puzzle out what I’d missed in our conversation~"
    "{i}~Me encontré tratando de descifrar qué me había perdido en nuestra conversación~"

# game/rachel_route.rpy:1625
translate es racheldrivecontinuea_e3b4b2de:

    # "{i}~At the local market we picked out meat, vegetables and fruit, and I replenished the spice collection while Rachel was perusing the snacks section~"
    "{i}~En el mercado local elegimos carne, verduras y fruta, y reabastecí la colección de especias mientras Rachel revisaba la sección de snacks~"

# game/rachel_route.rpy:1627
translate es racheldrivecontinuea_4f89110e:

    # x "Do you need wine?"
    x "¿Necesitas vino?"

# game/rachel_route.rpy:1629
translate es racheldrivecontinuea_db393cbb:

    # r "Remember? There’s a whole cellar of the asshole’s good stuff waiting for us back at the house."
    r "¿Recuerdas? En la casa nos espera una bodega entera con las cosas buenas de ese imbécil."

# game/rachel_route.rpy:1637
translate es racheldrivecontinuea_a69a5b1c:

    # x "I just remember dad yelling at you not to drink any of his ‘special vintages’."
    x "Solo recuerdo a papá gritándote que no te tomaras ninguna de sus ‘cosechas especiales’."

# game/rachel_route.rpy:1639
translate es racheldrivecontinuea_9d191681:

    # r "Your dad doesn’t know how to enjoy life. What’s the purpose of owning fine wines if you never drink them?"
    r "Tu papá no sabe disfrutar la vida. ¿De qué sirve tener vinos finos si nunca te los tomas?"

# game/rachel_route.rpy:1641
translate es racheldrivecontinuea_b290634f:

    # n2 "[x]?"
    n2 "[x]?"

# game/rachel_route.rpy:1654
translate es racheldrivecontinuea_1a851b56:

    # "{i}~Nicole’s pretty features interrupted us with a wave of her hand~"
    "{i}~El lindo rostro de Nicole nos interrumpió con un gesto de su mano~"

# game/rachel_route.rpy:1656
translate es racheldrivecontinuea_db702638:

    # x "{i}What the fuck is she doing here?{size=26}{i}{color=#A9A9A9}~I thought~"
    x "{i}¿Qué carajo hace ella aquí?{size=26}{i}{color=#A9A9A9}~pensé~"

# game/rachel_route.rpy:1665
translate es racheldrivecontinuea_3807e978:

    # x "Oh hey, Nicole..."
    x "Ah, hola, Nicole..."

# game/rachel_route.rpy:1667
translate es racheldrivecontinuea_dee83f65:

    # x "Let me introduce you to my..."
    x "Déjame presentarte a mi..."

# game/rachel_route.rpy:1676
translate es racheldrivecontinuea_cbfa3835:

    # "{i}~To my surprise she gave me a quick kiss in front of Rachel~"
    "{i}~Para mi sorpresa, me dio un beso rápido frente a Rachel~"

# game/rachel_route.rpy:1678
translate es racheldrivecontinuea_920fdee0:

    # r "Ehm, okay..."
    r "Eh, bueno..."

# game/rachel_route.rpy:1680
translate es racheldrivecontinuea_4b47a385:

    # r "I apologize for barging in but I just have to ask,"
    r "Perdón por irrumpir así, pero tengo que preguntar,"

# game/rachel_route.rpy:1682
translate es racheldrivecontinuea_9977c231:

    # r "Who are you?"
    r "¿Quién eres?"

# game/rachel_route.rpy:1691
translate es racheldrivecontinuea_3880727f:

    # n1 "I’m Nicole, [x]’s girlfriend."
    n1 "Soy Nicole, la novia de [x]."

# game/rachel_route.rpy:1693
translate es racheldrivecontinuea_5a99299d:

    # n1 "And who are you?"
    n1 "¿Y tú quién eres?"

# game/rachel_route.rpy:1695
translate es racheldrivecontinuea_ccb88696:

    # x "Nicole, may I introduce you to my [m]."
    x "Nicole, déjame presentarte a mi [m]."

# game/rachel_route.rpy:1704
translate es racheldrivecontinuea_ba9c1bee:

    # n1 "Oh, I’m so sorry Miss Sussex."
    n1 "Ay, lo siento mucho, señorita Sussex."

# game/rachel_route.rpy:1706
translate es racheldrivecontinuea_b7d82577:

    # n1 "[x] told me much about you, but I didn't imagine his [m] to be so beautiful and young looking."
    n1 "[x] me contó mucho sobre usted, pero no imaginé que su [m] fuera tan hermosa y luciera tan joven."

# game/rachel_route.rpy:1715
translate es racheldrivecontinuea_41ae4fe3:

    # r "Thank you, Nicole."
    r "Gracias, Nicole."

# game/rachel_route.rpy:1717
translate es racheldrivecontinuea_0130506f:

    # r "I would love to say the same, but [x] didn't mention that he had a girlfriend..."
    r "Me encantaría decir lo mismo, pero [x] no mencionó que tuviera novia..."

# game/rachel_route.rpy:1719
translate es racheldrivecontinuea_3e832a12:

    # x "Ehm, didn’t I? I must have forgot..."
    x "Eh, ¿no lo hice? Se me debe haber olvidado..."

# game/rachel_route.rpy:1728
translate es racheldrivecontinuea_6e7dc000:

    # n1 "Where did you get this? It’s gorgeous!"
    n1 "¿Dónde conseguiste esto? ¡Es precioso!"

# game/rachel_route.rpy:1730
translate es racheldrivecontinuea_f182bbc8:

    # r "Thank you,"
    r "Gracias,"

# game/rachel_route.rpy:1732
translate es racheldrivecontinuea_ac54bbca:

    # r "We sell them at my boutique."
    r "Los vendemos en mi boutique."

# game/rachel_route.rpy:1736
translate es racheldrivecontinuea_77a7832e:

    # n1 "You own a store?!"
    n1 "¿¡Tienes una tienda!?"

# game/rachel_route.rpy:1738
translate es racheldrivecontinuea_fe110e30:

    # n1 "[x] didn’t told me that. Which one is it?"
    n1 "[x] no me contó eso. ¿Cuál es?"

# game/rachel_route.rpy:1740
translate es racheldrivecontinuea_12a1b7a4:

    # r "Amò, it’s in the shopping street down on Geary."
    r "Amò, está en la calle comercial, allá en Geary."

# game/rachel_route.rpy:1742
translate es racheldrivecontinuea_36f0397e:

    # n1 "I know that place! Oh, well, now I’ll have to go in."
    n1 "¡Conozco ese lugar! Ay, bueno, ahora voy a tener que entrar."

# game/rachel_route.rpy:1750
translate es racheldrivecontinuea_daa753eb:

    # "{i}~Nicole’s eyes fell upon me and ran approvingly up and down my form~"
    "{i}~Los ojos de Nicole se posaron en mí y recorrieron mi cuerpo de arriba abajo con aprobación~"

# game/rachel_route.rpy:1754
translate es racheldrivecontinuea_91cde326:

    # r "Come by the store tomorrow and I’ll have the girls set a wrap aside for you, half off."
    r "Pásate mañana por la tienda y haré que las chicas te aparten un chal, a mitad de precio."

# game/rachel_route.rpy:1756
translate es racheldrivecontinuea_b0db63e4:

    # r "Tell them you met me yesterday."
    r "Diles que me conociste ayer."

# game/rachel_route.rpy:1758
translate es racheldrivecontinuea_66f04e8e:

    # n1 "What? Why, thank you."
    n1 "¿Qué? Vaya, gracias."

# game/rachel_route.rpy:1760
translate es racheldrivecontinuea_46716a1c:

    # n1 "I certainly will recommend your place in the future."
    n1 "Sin duda recomendaré tu tienda en el futuro."

# game/rachel_route.rpy:1768
translate es racheldrivecontinuea_b55b82a9:

    # "{i}~Nicole’s smile moved back to me, her eyes flashed again with a naughty gleam~"
    "{i}~La sonrisa de Nicole volvió hacia mí, sus ojos brillaron otra vez con un destello travieso~"

# game/rachel_route.rpy:1772
translate es racheldrivecontinuea_2946a1a0:

    # n1 "I don't want to disturb your reunion, I am sure you two have been waiting a long time for this moment and need to talk."
    n1 "No quiero interrumpir su reencuentro, estoy segura de que llevaban mucho tiempo esperando este momento y necesitan hablar."

# game/rachel_route.rpy:1774
translate es racheldrivecontinuea_c2b99e8b:

    # n1 "It was so lovely meeting you, Miss Sussex."
    n1 "Fue un placer conocerla, señorita Sussex."

# game/rachel_route.rpy:1776
translate es racheldrivecontinuea_0aa03bbe:

    # r "The pleasure is all mine, Nicole."
    r "El placer es todo mío, Nicole."

# game/rachel_route.rpy:1778
translate es racheldrivecontinuea_6e55d317:

    # r "Would you like to come over for dinner? I'm making food."
    r "¿Te gustaría venir a cenar? Voy a cocinar."

# game/rachel_route.rpy:1781
translate es racheldrivecontinuea_c3ccd18c:

    # n1 "I wish I could say yes, but there are some important matters that need tending to. "
    n1 "Me encantaría decir que sí, pero tengo algunos asuntos importantes que atender. "

# game/rachel_route.rpy:1783
translate es racheldrivecontinuea_749c4f72:

    # n1 "Maybe we can arrange something for another day."
    n1 "Quizás podamos organizar algo para otro día."

# game/rachel_route.rpy:1785
translate es racheldrivecontinuea_3ef2589c:

    # r "I would love that."
    r "Me encantaría."

# game/rachel_route.rpy:1793
translate es racheldrivecontinuea_9918437f:

    # n1 "Baby, will we see each other later at my place?"
    n1 "Bebé, ¿nos vemos más tarde en mi casa?"

# game/rachel_route.rpy:1795
translate es racheldrivecontinuea_27d4f9a8:

    # x "Of course, ehm, baby."
    x "Claro, eh, bebé."

# game/rachel_route.rpy:1804
translate es racheldrivecontinuea_b3015cd9:

    # "{i}~Nicole walked away from us, and I felt butterflies dancing in my stomach at the sight of her perfect butt~"
    "{i}~Nicole se alejó de nosotros y sentí mariposas revoloteando en mi estómago al ver su trasero perfecto~"

# game/rachel_route.rpy:1806
translate es racheldrivecontinuea_27d9ef66:

    # "{i}~Rachel pointedly didn’t look over at me, but I didn’t sense anger from her posture or scent, more confusion~"
    "{i}~Rachel evitó mirarme a propósito, pero no percibí enojo en su postura ni en su aroma, más bien confusión~"

# game/rachel_route.rpy:1815
translate es racheldrivecontinuea_7e7c6994:

    # r "So..."
    r "Entonces..."

# game/rachel_route.rpy:1817
translate es racheldrivecontinuea_a8a8bb0b:

    # r "You have a grilfriend?"
    r "¿Tienes novia?"

# game/rachel_route.rpy:1819
translate es racheldrivecontinuea_0d1cc7d8:

    # r "How long has this been going on?"
    r "¿Desde cuándo pasa esto?"

# game/rachel_route.rpy:1823
translate es racheldrivecontinuea_263a422a:

    # x "Not for too long."
    x "No desde hace mucho."

# game/rachel_route.rpy:1829
translate es racheldrivecontinuea_263a422a_1:

    # x "Not for too long."
    x "No desde hace mucho."

# game/rachel_route.rpy:1840
translate es racheldrivecontinuea_338723e5:

    # r "Does the young girl know that you are not being faithful?"
    r "¿Sabe esa jovencita que no le eres fiel?"

# game/rachel_route.rpy:1842
translate es racheldrivecontinuea_2563b752:

    # x "[m!c]..."
    x "[m!c]..."

# game/rachel_route.rpy:1846
translate es racheldrivecontinuea_3706eac2:

    # "{i}~I rested a hand on her shoulder and frowned when she flinched, her expression one of pain but her scent that of desire~"
    "{i}~Apoyé una mano en su hombro y fruncí el ceño cuando se estremeció, con expresión de dolor pero un aroma de deseo~"

# game/rachel_route.rpy:1848
translate es racheldrivecontinuea_4c9d0290:

    # "{i}~She opened her mouth to cut me off again, but I overrode her~"
    "{i}~Abrió la boca para interrumpirme de nuevo, pero no la dejé~"

# game/rachel_route.rpy:1850
translate es racheldrivecontinuea_59d0d46f:

    # x "This is important. With everything that’s happened, with all these changes…"
    x "Esto es importante. Con todo lo que ha pasado, con todos estos cambios…"

# game/rachel_route.rpy:1852
translate es racheldrivecontinuea_4eb8e270:

    # x "I need to know… that you don’t think I’m a monster or something."
    x "Necesito saber… que no piensas que soy un monstruo o algo así."

# game/rachel_route.rpy:1860
translate es racheldrivecontinuea_ab2cbd78:

    # r "Oh, [x], never!"
    r "¡Ay, [x], nunca!"

# game/rachel_route.rpy:1862
translate es racheldrivecontinuea_25427493:

    # "{i}~Her expression changed, melting into one of reassurance and love~"
    "{i}~Su expresión cambió, suavizándose hasta mostrar tranquilidad y amor~"

# game/rachel_route.rpy:1871
translate es racheldrivecontinuea_04eff279:

    # "{i}~She stepped close and rested her hand on my cheek before pulling it back as if burned~"
    "{i}~Se acercó y apoyó su mano en mi mejilla antes de retirarla como si se hubiera quemado~"

# game/rachel_route.rpy:1875
translate es racheldrivecontinuea_a0122b6e:

    # r "This has changed all of us, and no, I’d never think any less of you."
    r "Esto nos cambió a todos, y no, nunca pensaría menos de ti."

# game/rachel_route.rpy:1877
translate es racheldrivecontinuea_6755a497:

    # r "Especially not because... you know..."
    r "Y menos por... ya sabes..."

# game/rachel_route.rpy:1879
translate es racheldrivecontinuea_cc23758c:

    # r "I’m sure you and Nicole will be very happy together."
    r "Estoy segura de que tú y Nicole serán muy felices juntos."

# game/rachel_route.rpy:1887
translate es racheldrivecontinuea_2c10f2b9:

    # "{i}~She tried to sound happy, but there was a stiffness to her tone and a sharpness to her scent that was quickly s[m]ed by love, making it impossible to discern~"
    "{i}~Intentó sonar feliz, pero había rigidez en su tono y una agudeza en su aroma que rápidamente fue s[m]ed por el amor, lo que hacía imposible distinguirlo~"

# game/rachel_route.rpy:1889
translate es racheldrivecontinuea_720fafd1:

    # "{i}~I had to get away from the scent of her. It was driving the beast within me wild, even after it had sated itself a few hours ago upon Linda~"
    "{i}~Tenía que alejarme de su aroma. Estaba volviendo loca a la bestia dentro de mí, incluso después de haberse saciado hacía unas horas con Linda~"

# game/rachel_route.rpy:1900
translate es racheldrivecontinue2a_7b0b4a1e:

    # x "Nicole is an amazing girl, I'm sure you'll love her."
    x "Nicole es una chica increíble, estoy seguro de que te va a encantar."

# game/rachel_route.rpy:1902
translate es racheldrivecontinue2a_88d7ef03:

    # x "But I'll let you figure it out on your own."
    x "Pero dejaré que lo descubras por ti misma."

# game/rachel_route.rpy:1911
translate es racheldrivecontinue2a_2f3666a1:

    # cust "Oh my God, are you Rachel?"
    cust "Dios mío, ¿eres Rachel?"

# game/rachel_route.rpy:1913
translate es racheldrivecontinue2a_1f64584f:

    # cust "I love your clothing line."
    cust "Me encanta tu línea de ropa."

# game/rachel_route.rpy:1915
translate es racheldrivecontinue2a_bbe1af14:

    # r "Thank you. Make sure to visit our new summer collection, we have discount right now."
    r "Gracias. No dejes de visitar nuestra nueva colección de verano, tenemos descuentos ahora mismo."

# game/rachel_route.rpy:1917
translate es racheldrivecontinue2a_935de3d8:

    # cust "I certainly will. Thank you."
    cust "Claro que sí. Gracias."

# game/rachel_route.rpy:1921
translate es racheldrivecontinue2a_bf69c693:

    # x "Are you always stopped like that?"
    x "¿Siempre te detienen así?"

# game/rachel_route.rpy:1923
translate es racheldrivecontinue2a_e59dc40b:

    # r "In this neighborhood? Yes."
    r "¿En este barrio? Sí."

# game/rachel_route.rpy:1925
translate es racheldrivecontinue2a_6466a1b8:

    # r "My days of being recognized by gearheads and magazine fans are long gone. And you, you’re going to have to get used to things like that."
    r "Mis días de ser reconocida por fanáticos de los autos y de las revistas quedaron muy atrás. Y tú, vas a tener que acostumbrarte a cosas así."

# game/rachel_route.rpy:1933
translate es racheldrivecontinue2a_22403c9b:

    # "{i}~She elbowed me and cast her eyes to the woman around the corner~"
    "{i}~Me dio un codazo y dirigió la mirada hacia la mujer de la esquina~"

# game/rachel_route.rpy:1935
translate es racheldrivecontinue2a_598f5a8e:

    # "{i}~I couldn’t drag my eyes away from the woman’s wide behind as it swung from side to side and felt my cheeks warm when she caught me staring~"
    "{i}~No podía apartar los ojos del amplio trasero de la mujer mientras se balanceaba de un lado a otro y sentí que me ardían las mejillas cuando me sorprendió mirándola~"

# game/rachel_route.rpy:1944
translate es racheldrivecontinue2a_2313e80b:

    # "{i}~Rachel laughed too, causing me to cringe, but her eyes held a flirty amusement I’d never seen directed at me before~"
    "{i}~Rachel también se rio, lo que me hizo encogerme, pero sus ojos tenían una diversión coqueta que nunca había visto dirigida hacia mí~"

# game/rachel_route.rpy:1953
translate es racheldrivecontinue2a_c5d346e3:

    # "{i}~As she took the cart from me, her hips brushing up against mine~"
    "{i}~Mientras tomaba el carrito de mis manos, sus caderas rozaron las mías~"

# game/rachel_route.rpy:1955
translate es racheldrivecontinue2a_182fd46f:

    # r "This area has the highest number of wealthy divorcees in the world, not just the country."
    r "Esta zona tiene la mayor cantidad de divorciadas adineradas del mundo, no solo del país."

# game/rachel_route.rpy:1957
translate es racheldrivecontinue2a_2553bbfb:

    # r "You’re going to have to get used to being checked out like a piece of meat in places like this."
    r "Vas a tener que acostumbrarte a que te miren como un pedazo de carne en lugares como este."

# game/rachel_route.rpy:1964
translate es racheldrivecontinue2a_05260e4d:

    # "{i}~I blinked and took a peek of her behind, but Rachel didn’t seem to notice as she glanced in the cart~"
    "{i}~Parpadeé y le eché un vistazo a su trasero, pero Rachel pareció no notarlo mientras miraba dentro del carrito~"

# game/rachel_route.rpy:1966
translate es racheldrivecontinue2a_66766d93:

    # r "Oh shoot, I forgot to grab bread. Could you run to the bakery and grab a baguette?"
    r "Ay, rayos, olvidé agarrar pan. ¿Podrías correr a la panadería y traer una baguette?"

# game/rachel_route.rpy:1968
translate es racheldrivecontinue2a_de1a0bdf:

    # x "Sure [m], I’ll be right back."
    x "Claro, [m], vuelvo enseguida."

# game/rachel_route.rpy:1973
translate es racheldrivecontinue2a_58cc59b1:

    # "{i}~I blinked and stumbled, as Rachel glanced in the cart~"
    "{i}~Parpadeé y tropecé, mientras Rachel miraba dentro del carrito~"

# game/rachel_route.rpy:1975
