    x "Estamos todos juntos aquí, no hay necesidad de celos ni de posesividad."

# game/mansion_route.rpy:574
translate es replayscene16_4f5acc1e:

    # "They nodded mutely, seemingly chastened by my words."
    "Asintieron en silencio, aparentemente avergonzadas por mis palabras."

# game/mansion_route.rpy:576
translate es replayscene16_b0b8c414:

    # n1 "Of course, Master. We apologize if we upset you."
