    n1 "Vivimos para servirle, mi señor."

# game/mansion_route.rpy:567
translate es replayscene16_eea1f1ec:

    # x "Enough, both of you! This is not a competition."
    x "¡Basta, las dos! Esto no es una competencia."

# game/mansion_route.rpy:569
translate es replayscene16_a72d3acd:

    # "Their gazes snapped back to me, surprise etched in their features. I took this opportunity to reassert my authority, reminding them who was the master of this house."
    "Sus miradas volvieron de golpe hacia mí, con la sorpresa marcada en sus rostros. Aproveché la oportunidad para reafirmar mi autoridad y recordarles quién era el amo de esta casa."

# game/mansion_route.rpy:571
translate es replayscene16_0f651456:

