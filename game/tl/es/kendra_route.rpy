# TODO: Translation updated at 2026-10-31 00:52

# game/kendra_route.rpy:14
translate es storyscene1_0c6f9cab:

    # k "You’re telling me I’m broke?!"
    k "¿Me estás diciendo que estoy en la ruina?"

# game/kendra_route.rpy:16
translate es storyscene1_1002a046:

    # "{i}~I was trying to keep calm, but from the glances I got from the man, I was failing miserably~"
    "{i}~Trataba de mantener la calma, pero por las miradas que me lanzaba el hombre, estaba fracasando estrepitosamente~"

# game/kendra_route.rpy:19
translate es storyscene1_40e1733a:

    # acc "That’s not the term I would use, ma’am,"
    acc "No es el término que yo usaría, señora,"

# game/kendra_route.rpy:21
translate es storyscene1_c7c83e0c:

    # acc "But your late husband was over-leveraged, and his assets are barely enough to cover the debt."
    acc "Pero su difunto esposo estaba sobreapalancado y sus bienes apenas alcanzan para cubrir la deuda."

# game/kendra_route.rpy:23
translate es storyscene1_87f393b3:

    # acc "He was in arrears on several payments, and with his passing… the banks are moving to collect."
    acc "Estaba atrasado en varios pagos y, con su fallecimiento… los bancos están empezando a cobrar."

# game/kendra_route.rpy:25
translate es storyscene1_2f25e9b0:

    # acc "I’m afraid if you can’t make the payments or clear the debt, the house, yacht, and the car will all be confiscated, and a hold will be placed on all of your accounts."
    acc "Me temo que si no puede hacer los pagos o saldar la deuda, la casa, el yate y el auto serán confiscados, y se pondrá una retención sobre todas sus cuentas."

# game/kendra_route.rpy:33
translate es storyscene1_038d6cc6:

    # k "Wait,"
    k "Espera,"

# game/kendra_route.rpy:35
translate es storyscene1_1c7f6b84:

    # "{i}~My head spinning as I tried to process the news~"
    "{i}~La cabeza me daba vueltas mientras trataba de procesar la noticia~"

# game/kendra_route.rpy:37
translate es storyscene1_50ec6862:

    # k "I don’t understand."
    k "No entiendo."

# game/kendra_route.rpy:41
translate es storyscene1_4c9380cf:

    # acc "Ms. Beverley, Forgive me for speaking ill of the dead, but I had been warning your late husband for years that he was living above his means."
    acc "Sra. Beverley, perdóneme por hablar mal de los muertos, pero llevaba años advirtiéndole a su difunto esposo que vivía por encima de sus posibilidades."

# game/kendra_route.rpy:43
translate es storyscene1_2c5d12c9:

    # acc "He was engaged in some very shady debt practices that are considered… illegal in certain states."
    acc "Estaba metido en prácticas de deuda muy turbias que se consideran… ilegales en ciertos estados."

# game/kendra_route.rpy:45
translate es storyscene1_644170a5:

    # acc "The banks are going to find out, very soon, and when they do, their retribution against those who hold his debt in their names, are going to be swift and brutal."
    acc "Los bancos se van a enterar, muy pronto, y cuando lo hagan, su castigo contra quienes tengan su deuda a su nombre será rápido y brutal."

# game/kendra_route.rpy:47
translate es storyscene1_b65f8db0:

    # acc "You would do well to sell everything and pay it off before that happens."
    acc "Le convendría vender todo y pagarlo antes de que eso pase."

# game/kendra_route.rpy:55
translate es storyscene1_e23bbd29:

    # k "How soon, till they come after me?"
    k "¿Cuánto falta para que vengan por mí?"

# game/kendra_route.rpy:57
translate es storyscene1_0af73212:

    # acc "I would be confident saying you have a month. After that..."
    acc "Me atrevería a decir que tiene un mes. Después de eso..."

# game/kendra_route.rpy:59
translate es storyscene1_7237ac76:

    # acc "Certainly, by the first of the next month, they will begin to inquire, and I’m required by law to provide them with the details of Mr. Beverley’s financial records if they have a court order."
    acc "Sin duda, para el primero del próximo mes, empezarán a hacer averiguaciones, y estoy obligado por ley a proporcionarles los detalles de los registros financieros del Sr. Beverley si tienen una orden judicial."

# game/kendra_route.rpy:61
translate es storyscene1_91135e95:

    # acc "Which they will."
    acc "Y la tendrán."

# game/kendra_route.rpy:70
translate es storyscene1_ef1fe7df:

    # k "One month..."
    k "Un mes..."

# game/kendra_route.rpy:72
translate es storyscene1_88852a8c:

    # "{i}~I shook my head, feeling like the world was crashing down around me~"
    "{i}~Negué con la cabeza, sintiendo que el mundo se derrumbaba a mi alrededor~"

# game/kendra_route.rpy:74
translate es storyscene1_d99bb0db:

    # k "I have one month to pay off his debts or lose everything."
    k "Tengo un mes para pagar sus deudas o perderlo todo."

# game/kendra_route.rpy:76
translate es storyscene1_3113f223:

    # "{i}~Looking up at the skiny man, I saw sweat beading on his bald pate, and I knew there was no hope of trying to get him to cover this up. A man like him would crack under the slightest pressure~"
    "{i}~Al levantar la vista hacia el hombre flaco, vi gotas de sudor en su calva y supe que no había esperanza de lograr que encubriera esto. Un hombre como él se quebraría ante la más mínima presión~"

# game/kendra_route.rpy:78
translate es storyscene1_eaa19e86:

    # k "How much in total?"
    k "¿Cuánto es en total?"

# game/kendra_route.rpy:82
translate es storyscene1_cfff6b60:

    # acc "1.37 million,"
    acc "1.37 millones,"

# game/kendra_route.rpy:84
translate es storyscene1_06fabc9b:

    # acc "That’s the debt in total. The payment amount for this month, including all accounts, is 74 thousand."
    acc "Esa es la deuda total. El monto del pago de este mes, incluyendo todas las cuentas, es de 74 mil."

# game/kendra_route.rpy:86
translate es storyscene1_49ecf72b:

    # "{i}~It was all too much, and suddenly I had to be out of there. Away from this annoying bold man and his disapproving stares~"
    "{i}~Todo era demasiado y, de repente, tuve que salir de ahí. Lejos de este molesto hombre calvo y sus miradas de desaprobación~"

# game/kendra_route.rpy:94
translate es storyscene1_b9edb4c8:

    # "{i}~Standing, I staggered out of his office~"
    "{i}~Me levanté y salí tambaleándome de su oficina~"

# game/kendra_route.rpy:96
translate es storyscene1_fcef33ae:

    # acc "I will have to arrange for assessors to review the properties."
    acc "Tendré que organizar que los tasadores revisen las propiedades."

# game/kendra_route.rpy:98
translate es storyscene1_5c10f69c:

    # acc "Expect to see them any day!"
    acc "¡Espérelos cualquier día de estos!"

# game/kendra_route.rpy:102
translate es storyscene1_4d50632d:

    # "{i}~The secretary and other women in the office glanced away nervously, burying their heads in their keyboards and pretending not to notice me~"
    "{i}~La secretaria y las demás mujeres de la oficina apartaron la mirada nerviosamente, hundiendo la cabeza en sus teclados y fingiendo no notarme~"

# game/kendra_route.rpy:104
translate es storyscene1_dac77446:

    # "{i}~I’m used to that kind of reaction from women. You don’t go through life looking like I do, without recognizing envy in women’s faces~"
    "{i}~Estoy acostumbrada a ese tipo de reacción de las mujeres. No pasas por la vida viéndote como yo sin reconocer la envidia en los rostros de las mujeres~"

# game/kendra_route.rpy:112
translate es storyscene1_78779549:

    # "{i}~Ignoring them, I strode out to my car~"
    "{i}~Ignorándolas, salí con paso firme hacia mi auto~"

# game/kendra_route.rpy:116
translate es storyscene1_76ae19bc:

    # "{i}~As I sat in the plush leather seat, gripping the wheel, a sudden wave of anxiety and stress rolled over me, and I felt the tears threatening to overwhelm~"
    "{i}~Al sentarme en el mullido asiento de cuero, agarrando el volante, una repentina oleada de ansiedad y estrés me invadió y sentí que las lágrimas amenazaban con desbordarme~"

# game/kendra_route.rpy:118
translate es storyscene1_1f058e0e:

    # "{i}~Biting the inside of my bottom lip, an old habit for dealing with anxiety or pressure, and continuing until I tasted blood~"
    "{i}~Mordiéndome el interior del labio inferior, una vieja costumbre para lidiar con la ansiedad o la presión, y continuando hasta saborear sangre~"

# game/kendra_route.rpy:120
translate es storyscene1_95e522e4:

    # "{i}~With the sharp pain, came a moment or two of relief from the stress, and I gathered my wits~"
    "{i}~Con el dolor agudo llegó un momento o dos de alivio del estrés, y recuperé la compostura~"

# game/kendra_route.rpy:128
translate es storyscene1_25801977:

    # k "That son of a bitch isn’t getting the last laugh!"
    k "¡Ese hijo de puta no se va a reír al último!"

# game/kendra_route.rpy:130
translate es storyscene1_dd952d91:

    # "{i}~I growled to myself, not sure whether I meant the accountant or my late husband~"
    "{i}~Gruñí para mí misma, sin saber si me refería al contador o a mi difunto esposo~"

# game/kendra_route.rpy:134
translate es storyscene1_efcf8930:

    # "{i}~I drove up into the hills, already late for my lunch at the country club~"
    "{i}~Conduje hacia las colinas, ya llegando tarde a mi almuerzo en el club de campo~"

# game/kendra_route.rpy:136
translate es storyscene1_921c82d0:

    # "{i}~Cursing myself the whole drive for not looking into the finances before he passed~"
    "{i}~Maldiciéndome durante todo el camino por no haber revisado las finanzas antes de que él muriera~"

# game/kendra_route.rpy:138
translate es storyscene1_77e49fe5:

    # "{i}~I almost pulled over to a corner store and bought a pack of cigarettes, something I hadn’t done since my modeling days~"
    "{i}~Casi me detengo en una tienda de la esquina a comprar una cajetilla de cigarrillos, algo que no hacía desde mis días de modelo~"

# game/kendra_route.rpy:141
translate es storyscene1_20959613:

    # "{i}~Finally, I got to the club, and the valet took my keys~"
    "{i}~Finalmente llegué al club y el valet tomó mis llaves~"

# game/kendra_route.rpy:144
translate es storyscene1_add2e11c:

    # "{i}~Hurrying through the elegant lobby and into the clubhouse, I found Linda already drinking a glass of wine while she waited for me~"
    "{i}~Atravesando a toda prisa el elegante vestíbulo y entrando en la casa club, encontré a Linda ya tomando una copa de vino mientras me esperaba~"

# game/kendra_route.rpy:156
translate es storyscene1_81e5cb1e:

    # li "Dahling, there you are."
    li "Querida, ahí estás."

# game/kendra_route.rpy:160
translate es storyscene1_27b5e656:

    # li "You look stunning as always."
    li "Te ves deslumbrante, como siempre."

# game/kendra_route.rpy:168
translate es storyscene1_36522ea1:

    # li "Look at this madness? You’d think the groundskeepers would deal with it."
    li "¿Mira esta locura? Uno pensaría que los jardineros se encargarían de esto."

# game/kendra_route.rpy:170
translate es storyscene1_a793a94d:

    # "{i}~She pointed out at the golf course, where a flock of ducks waddled across a green, leaving a trail of poop behind~"
    "{i}~Señaló hacia el campo de golf, donde una bandada de patos avanzaba balanceándose por un green, dejando un rastro de caca detrás~"

# game/kendra_route.rpy:172
translate es storyscene1_203f3584:

    # li "This place is falling apart."
    li "Este lugar se está cayendo a pedazos."

# game/kendra_route.rpy:181
translate es storyscene1_9bfdbd1c:

    # li "Tell me how the meeting went, were you pleasantly surprised? Or did the old cancer fuck you over?"
    li "Cuéntame cómo fue la reunión, ¿te llevaste una sorpresa agradable? ¿O el viejo cáncer te jodió?"

# game/kendra_route.rpy:183
translate es storyscene1_8c603c85:

    # k "The old fool died and left me nothing."
    k "El viejo tonto murió y no me dejó nada."

# game/kendra_route.rpy:185
translate es storyscene1_61e909ee:

    # "{i}~My voice tinged with bitterness. Motioning for the waiter to bring me a glass of wine~"
    "{i}~Mi voz teñida de amargura. Le hice una seña al mesero para que me trajera una copa de vino~"

# game/kendra_route.rpy:194
translate es storyscene1_9a6ee855:

    # k "Apparently, he was in tremendous debt."
    k "Al parecer, tenía una deuda tremenda."

# game/kendra_route.rpy:196
translate es storyscene1_56419d5e:

    # li "You’re serious? You said the man was worth millions!"
    li "¿Hablas en serio? ¡Dijiste que ese hombre valía millones!"

# game/kendra_route.rpy:198
translate es storyscene1_6c95f6d4:

    # k "He was, or he told me he was."
    k "Los valía, o me dijo que los valía."

# game/kendra_route.rpy:200
translate es storyscene1_3adf378e:

    # k "It looks like he was living on debt for years, maybe decades. His monthly salary just covered the payments, and now that he’s gone..."
    k "Parece que vivió endeudado durante años, quizá décadas. Su salario mensual apenas cubría los pagos, y ahora que ya no está..."

# game/kendra_route.rpy:209
translate es storyscene1_19c16a45:

    # li "Dahling, that’s terrible!"
    li "¡Querida, eso es terrible!"

# game/kendra_route.rpy:211
translate es storyscene1_d15d2221:

    # li "We simply must do something about this. Come, drink your wine, relax."
    li "Simplemente tenemos que hacer algo al respecto. Ven, toma tu vino, relájate."

# game/kendra_route.rpy:213
translate es storyscene1_bec3d902:

    # li "Leave it to Linda, dear, I’ll figure something out."
    li "Déjaselo a Linda, querida, yo resolveré algo."

# game/kendra_route.rpy:215
translate es storyscene1_e1df0e1e:

    # li "Now tell me all about it."
    li "Ahora cuéntame todo."

# game/kendra_route.rpy:219
translate es storyscene1_f005d3b1:

    # "{i}~I told her all about my morning meetings with the lawyers, business managers, and the accountant~"
    "{i}~Le conté todo sobre mis reuniones de la mañana con los abogados, los administradores de negocios y el contador~"

# game/kendra_route.rpy:221
translate es storyscene1_7914f5af:

    # "{i}~Linda was the perfect person to talk to. Not only was she a good friend and a sweetheart, but she’d also been through something similar when her first husband passed away~"
    "{i}~Linda era la persona perfecta con quien hablar. No solo era una buena amiga y un amor, sino que también había pasado por algo parecido cuando murió su primer esposo~"

# game/kendra_route.rpy:223
translate es storyscene1_e2a6a8e7:

    # "{i}~Since high school we have been good friends, we’d grown close as sisters, able to tell each other anything~"
    "{i}~Desde la secundaria hemos sido buenas amigas, nos hemos vuelto tan cercanas como hermanas, capaces de contarnos cualquier cosa~"

# game/kendra_route.rpy:226
translate es storyscene1_8c2186ee:

    # "{i}~The rest of the tables in the clubhouse dining room were filled with other women, all here for a late lunch or early champaign~"
    "{i}~El resto de las mesas del comedor de la casa club estaban llenas de otras mujeres, todas aquí para un almuerzo tardío o un champán temprano~"

# game/kendra_route.rpy:228
translate es storyscene1_bfb56b1d:

    # "{i}~A sea of white tennis skirts, bleach blonde hair, and fake tits~"
    "{i}~Un mar de faldas blancas de tenis, cabello rubio decolorado y tetas falsas~"

# game/kendra_route.rpy:230
translate es storyscene1_b3bbc5b1:

    # "{i}~I always found these women so tiresome, and the surge of pride I usually felt when I felt their side-eye stares, was absent~"
    "{i}~Siempre me parecieron tan cansadoras estas mujeres, y la oleada de orgullo que solía sentir cuando percibía sus miradas de reojo estaba ausente~"

# game/kendra_route.rpy:239
translate es storyscene1_d5eeacda:

    # "{i}~I make no pretensions about who or what I am~"
    "{i}~No pretendo ser otra cosa que lo que soy~"

# game/kendra_route.rpy:241
translate es storyscene1_9f8fc6aa:

    # "{i}~I was sixteen when discovered by a modeling agency out of New York. By the end of that summer, I was making more money than my parents~"
    "{i}~Tenía dieciséis años cuando me descubrió una agencia de modelos de Nueva York. Al final de ese verano, ya ganaba más dinero que mis padres~"

# game/kendra_route.rpy:243
translate es storyscene1_4b27e40d:

    # "{i}~After a stint with Victoria’s Secret when I was twenty, my bust developed too much for me to continue modeling~"
    "{i}~Después de una temporada con Victoria’s Secret cuando tenía veinte, mi busto se desarrolló demasiado para seguir modelando~"

# game/kendra_route.rpy:245
translate es storyscene1_af2d7127:

    # "{i}~A few years later, I met my husband, who was decades older and wealthy, able to provide me with the lifestyle I’d become accustomed to~"
    "{i}~Unos años después conocí a mi esposo, que era décadas mayor y rico, capaz de darme el estilo de vida al que me había acostumbrado~"

# game/kendra_route.rpy:247
translate es storyscene1_c0a62e1e:

    # "{i}~I wish I could say it was a union of love, but the truth is I married him for the lifestyle. He was a good man, showering me with gifts and attention throughout our marriage~"
    "{i}~Ojalá pudiera decir que fue una unión por amor, pero la verdad es que me casé con él por el estilo de vida. Era un buen hombre, me colmaba de regalos y atenciones durante todo nuestro matrimonio~"

# game/kendra_route.rpy:249
translate es storyscene1_a3e24187:

    # "{i}~I never had to worry about him cheating since he wasn’t ever able to get it up, even with pills~"
    "{i}~Nunca tuve que preocuparme de que me engañara, ya que nunca lograba que se le parara, ni siquiera con pastillas~"

# game/kendra_route.rpy:258
translate es storyscene1_75245daa:

    # k "The old fool didn’t even have a life insurance policy, there is nothing left for me."
    k "El viejo tonto ni siquiera tenía una póliza de seguro de vida, no me quedó nada."

# game/kendra_route.rpy:260
translate es storyscene1_a78446cd:

    # k "I’m going to have to start all over. But what can I do? Get a job? What skills do I have?"
    k "Voy a tener que empezar todo de cero. Pero ¿qué puedo hacer? ¿Conseguir un trabajo? ¿Qué habilidades tengo?"

# game/kendra_route.rpy:264
translate es storyscene1_03a5cc46:

    # li "Nonsense dahling, you’re too gorgeous to work a nine to five."
    li "Tonterías, querida, eres demasiado hermosa para trabajar de nueve a cinco."

# game/kendra_route.rpy:266
translate es storyscene1_5840fb2d:

    # k "What about [x]? Didn’t his uncle leave him a big fortune?"
    k "¿Y qué hay de [x]? ¿Su tío no le dejó una gran fortuna?"

# game/kendra_route.rpy:268
translate es storyscene1_83a8b228:

    # li "Rachel told me that [x]’s money comes from his father’s side, held in trust,"
    li "Rachel me dijo que el dinero de [x] viene por parte de su padre, está en un fideicomiso,"

# game/kendra_route.rpy:270
translate es storyscene1_c7562804:

    # li "It’s safe, but he can’t access it for others until he’s twenty-five."
    li "Es seguro, pero no puede acceder a él para otros hasta que cumpla veinticinco."

# game/kendra_route.rpy:272
translate es storyscene1_3d8d397c:

    # li "His uncle made sure the boy’s life is paid for but other than that... you are on your own for the next six years."
    li "Su tío se aseguró de que el chico tenga la vida pagada, pero fuera de eso... estás por tu cuenta durante los próximos seis años."

# game/kendra_route.rpy:280
translate es storyscene1_6f45a5d0:

    # "{i}~Linda said thoughtfully, her tone causing me to glance over at her in curiosity~"
    "{i}~Linda lo dijo pensativa, con un tono que me hizo mirarla con curiosidad~"

# game/kendra_route.rpy:282
translate es storyscene1_af4978ac:

    # "{i}~The woman wore an expression that always made me nervous. She usually got it just before doing something wild~"
    "{i}~La mujer tenía esa expresión que siempre me ponía nerviosa. Solía ponerla justo antes de hacer alguna locura~"

# game/kendra_route.rpy:284
translate es storyscene1_bf0123fd:

    # "{i}~Such as the time she’d done molly with her daughter’s sorority friends, or when she and I’d gone skinny dipping at three am, after a few too many bottles of red wine and nearly kissed~"
    "{i}~Como aquella vez que tomó éxtasis con las amigas de la hermandad de su hija, o cuando nos metimos desnudas al agua a las tres de la mañana, después de unas cuantas botellas de vino tinto de más, y casi nos besamos~"

# game/kendra_route.rpy:288
translate es storyscene1_ba3e2b73:

    # k "What is it you’re thinking?{size=26}{i}{color=#A9A9A9}~not sure I wanted to hear~"
    k "¿En qué estás pensando?{size=26}{i}{color=#A9A9A9}~no estaba segura de querer escuchar~"

# game/kendra_route.rpy:290
translate es storyscene1_abb58e30:

    # li "You ever thought about getting back into modeling?"
    li "¿Alguna vez pensaste en volver al modelaje?"

# game/kendra_route.rpy:292
translate es storyscene1_1f57f18d:

    # k "Hmph, I don’t think there’s much money out there for a 38-year-old model."
    k "Hmph, no creo que haya mucho dinero para una modelo de 38 años."

# game/kendra_route.rpy:294
translate es storyscene1_eb706e5c:

    # k "Don’t tell me that’s your idea."
    k "No me digas que esa es tu idea."

# game/kendra_route.rpy:296
translate es storyscene1_ba7ddc58:

    # li "I wasn’t thinking that kind of model,"
    li "No estaba pensando en ese tipo de modelo,"

# game/kendra_route.rpy:299
translate es storyscene1_4ea53d36:

    # k "You don’t mean like on one of those sites?"
    k "¿No te referirás a... uno de esos sitios?"

# game/kendra_route.rpy:301
translate es storyscene1_1829a883:

    # k "For all the world to see?"
    k "¿Para que todo el mundo lo vea?"

# game/kendra_route.rpy:303
translate es storyscene1_db549684:

    # li "Certainly not, nothing so low class."
    li "Claro que no, nada tan vulgar."

# game/kendra_route.rpy:305
translate es storyscene1_9e7061cd:

    # li "Those sites offer basic services, and the models make a reasonable income, true."
    li "Esos sitios ofrecen servicios básicos, y las modelos ganan un ingreso razonable, es cierto."

# game/kendra_route.rpy:307
translate es storyscene1_2ae113e0:

    # li "Depending on their skill or attractiveness, they can even make decent money, but nothing serious."
    li "Según su habilidad o su atractivo, incluso pueden ganar un buen dinero, pero nada serio."

# game/kendra_route.rpy:315
translate es storyscene1_3f7fe911:

    # li "I’m talking about the exclusive sites. The ones that can’t be found from a simple google search."
    li "Yo hablo de los sitios exclusivos. Los que no se encuentran con una simple búsqueda en Google."

# game/kendra_route.rpy:317
translate es storyscene1_b37de1d8:

    # k "How do you know about all this?"
    k "¿Cómo sabes todo esto?"

# game/kendra_route.rpy:319
translate es storyscene1_4d75bc9e:

    # li "I used to track my second husband's credit card transactions, to see who he was cheating on me with."
    li "Antes revisaba los movimientos de la tarjeta de crédito de mi segundo esposo, para ver con quién me engañaba."

# game/kendra_route.rpy:321
translate es storyscene1_dccb17cd:

    # li "One time, a charge came through for fifteen grand, and I grew suspicious."
    li "Una vez apareció un cargo de quince mil dólares y me entró la sospecha."

# game/kendra_route.rpy:323
translate es storyscene1_64536196:

    # li "I lined it up with his browsing history and saw he’d spent a half-hour on a special cam site."
    li "Lo crucé con su historial de navegación y vi que había pasado media hora en un sitio especial de cámaras."

# game/kendra_route.rpy:332
translate es storyscene1_7bfa14e0:

    # k "What was he watching?"
    k "¿Qué estaba viendo?"

# game/kendra_route.rpy:334
translate es storyscene1_4052cbed:

    # "{i}~I asked, shocked at the amount of money~"
    "{i}~pregunté, impactada por la cantidad de dinero~"

# game/kendra_route.rpy:336
translate es storyscene1_6b7dc7f3:

    # li "If you’re not interested, I understand."
    li "Si no te interesa, lo entiendo."

# game/kendra_route.rpy:338
translate es storyscene1_ce0b767c:

    # "{i}~I could see she was being evasive and wasn’t going to answer my question~"
    "{i}~Vi que estaba esquivando el tema y que no iba a responder mi pregunta~"

# game/kendra_route.rpy:342
translate es storyscene1_99145675:

    # li "I can’t believe I’m even suggesting it. But if you really need the money, it’s the fastest way I know of to get it."
    li "No puedo creer que siquiera lo esté sugiriendo. Pero si de verdad necesitas el dinero, es la forma más rápida que conozco de conseguirlo."

# game/kendra_route.rpy:344
translate es storyscene1_a072c427:

    # k "What kinds of things… what would I have to do?"
    k "¿Qué tipo de cosas… qué tendría que hacer?"

# game/kendra_route.rpy:346
translate es storyscene1_1385ee3a:

    # "{i}~I asked, feeling my heart race. Was I seriously considering this?~"
    "{i}~pregunté, sintiendo que el corazón se me aceleraba. ¿En serio estaba considerando esto?~"

# game/kendra_route.rpy:354
translate es storyscene1_81993fe2:

    # li "Nothing at first,"
    li "Nada al principio,"

# game/kendra_route.rpy:356
translate es storyscene1_15dc9dbb:

    # li "Just meet with them, have a video call. If they agree to take you on, they’ll tell you the details..."
    li "Solo reunirte con ellos, tener una videollamada. Si aceptan tomarte, te contarán los detalles..."

# game/kendra_route.rpy:358
translate es storyscene1_9a9e7c8f:

    # li "Want me to pass along your number?"
    li "¿Quieres que les pase tu número?"

# game/kendra_route.rpy:360
translate es storyscene1_79965e51:

    # k "Sure,{size=26}{i}{color=#A9A9A9}~feeling a little light-headed~"
    k "Claro,{size=26}{i}{color=#A9A9A9}~sintiéndome un poco mareada~"

# game/kendra_route.rpy:362
translate es storyscene1_751fc84a:

    # k "Why not..."
    k "¿Por qué no...?"

# game/kendra_route.rpy:371
translate es storyscene1_22e4c21b:

    # li "How is [x] doing, anyway?"
    li "¿Cómo está [x], por cierto?"

# game/kendra_route.rpy:373
translate es storyscene1_f3d456ef:

    # "{i}~She asked, a sparkle entering her eyes as she brought up my [n]~"
    "{i}~preguntó, con un brillo en los ojos al mencionar a mi [n]~"

# game/kendra_route.rpy:375
translate es storyscene1_352fc133:

    # li "Is he still at home, or did he leave?"
    li "¿Sigue en casa o ya se fue?"

# game/kendra_route.rpy:379
translate es storyscene1_84d6b709:

    # k "Yes, I think he is still at home."
    k "Sí, creo que sigue en casa."

# game/kendra_route.rpy:381
translate es storyscene1_fb6357d0:

    # "{i}~I said, happy for the change of topic~"
    "{i}~dije, contenta por el cambio de tema~"

# game/kendra_route.rpy:383
translate es storyscene1_9bbfd206:

    # li "He’s a fine young man."
    li "Es un joven muy bueno."

# game/kendra_route.rpy:385
translate es storyscene1_5a30bc82:

    # "{i}~Linda said with a warm smile, the warmest I remember seeing from her~"
    "{i}~dijo Linda con una sonrisa cálida, la más cálida que recuerdo haberle visto~"

# game/kendra_route.rpy:387
translate es storyscene1_55740ab9:

    # li "Don’t you think? Handsome, sweet, and such a good boy."
    li "¿No crees? Guapo, dulce y tan buen chico."

# game/kendra_route.rpy:395
translate es storyscene1_3f66dbce:

    # k "I suppose,"
    k "Supongo,"

# game/kendra_route.rpy:397
translate es storyscene1_15475495:

    # k "To be honest, I don’t know him all that well. He’s always been so awkward and in his room on that computer."
    k "Para ser honesta, no lo conozco tan bien. Siempre ha sido tan torpe y encerrado en su cuarto con esa computadora."

# game/kendra_route.rpy:399
translate es storyscene1_0a7b4b9c:

    # k "My sister and I have raised him since he was a boy, but we’ve never been close."
    k "Mi hermana y yo lo criamos desde que era niño, pero nunca hemos sido cercanos."

# game/kendra_route.rpy:401
translate es storyscene1_e0813d73:

    # k "I worry about him even more since he has come home. His interests are all so… odd."
    k "Me preocupo aún más por él desde que volvió a casa. Todos sus intereses son tan… raros."

# game/kendra_route.rpy:405
translate es storyscene1_af80be78:

    # li "I wouldn’t worry about [x],"
    li "Yo no me preocuparía por [x],"

# game/kendra_route.rpy:407
translate es storyscene1_1fa0e381:

    # li "That boy’s going to be just fine. Being interested in computers isn’t a bad thing for a kid nowadays."
    li "Ese chico va a estar bien. Que le interesen las computadoras no es algo malo para un chico hoy en día."

# game/kendra_route.rpy:409
translate es storyscene1_102c744d:

    # "{i}~I knew she was right, [x] was one of the good ones. Despite what I’d said, I’d been thinking a lot about my [n] lately~"
    "{i}~Sabía que tenía razón, [x] era de los buenos. A pesar de lo que había dicho, últimamente había estado pensando mucho en mi [n]~"

# game/kendra_route.rpy:411
translate es storyscene1_1d9799d7:

    # "{i}~From what I saw, the boy was quiet and a bit of a recluse, but sweet and brilliant~"
    "{i}~Por lo que veía, el chico era callado y un poco ermitaño, pero dulce y brillante~"

# game/kendra_route.rpy:414
translate es storyscene1_8c47f254:

    # "{i}~He was also driven to succeed in everything he did, always wanting to be the best~"
    "{i}~También se esforzaba por tener éxito en todo lo que hacía, siempre quería ser el mejor~"

# game/kendra_route.rpy:416
translate es storyscene1_3b939ffa:

    # "{i}~Whether that was playing football, classes where he was one of the top students, or programming~"
    "{i}~Ya fuera jugando fútbol americano, en las clases donde era uno de los mejores estudiantes, o programando~"

# game/kendra_route.rpy:418
translate es storyscene1_287d5703:

    # "{i}~Throughout the rest of our lunch, Linda kept bringing [x] up, worrying about how he would adjust after his uncle’s passing, or if he was dating~"
    "{i}~Durante el resto del almuerzo, Linda no dejó de mencionar a [x], preocupada por cómo se adaptaría después de la muerte de su tío, o si estaba saliendo con alguien~"

# game/kendra_route.rpy:420
translate es storyscene1_ce31ba9d:

    # "{i}~She commented on him so much that I began to grow uncomfortable~"
    "{i}~Habló tanto de él que empecé a sentirme incómoda~"

# game/kendra_route.rpy:423
translate es storyscene1_f2401bea:

    # "{i}~Later as I stepped in the car, I found myself looking over pictures of the three of us from last year’s spring break, when we’d all gone on vacation to Bali~"
    "{i}~Más tarde, al subirme al auto, me encontré mirando fotos de nosotros tres de las vacaciones de primavera del año pasado, cuando fuimos todos a Bali~"

# game/kendra_route.rpy:431
translate es storyscene1_b71f1f87:

    # "[x] stood taller than me, and he was muscular, making him appear even more handsome beside my curvy frame and older than his nineteen summers~"
    "[x] era más alto que yo, y era musculoso, lo que lo hacía verse aún más guapo a mi lado, con mi figura curvilínea, y mayor de sus diecinueve años~"

# game/kendra_route.rpy:433
translate es storyscene1_51fd5436:

    # "{i}~His face was quite handsome, with the kind of chiseled jawline, that make women swoon~"
    "{i}~Su rostro era muy guapo, con ese tipo de mandíbula marcada que hace suspirar a las mujeres~"

# game/kendra_route.rpy:435
translate es storyscene1_af567255:

    # "{i}~His pale brown eyes were striking, and whenever he managed to look up from his shoes or the ground and addressed me properly, I was always arrested by their beauty~"
    "{i}~Sus ojos marrón claro eran llamativos, y cada vez que lograba levantar la vista de sus zapatos o del suelo y me hablaba como se debe, siempre me quedaba cautivada por su belleza~"

# game/kendra_route.rpy:444
translate es storyscene1_120bae63:

    # "{i}~Flipping through the pictures, I realized I’d never really taken much notice of [x] in them before~"
    "{i}~Al hojear las fotos, me di cuenta de que nunca me había fijado realmente en [x] en ellas~"

# game/kendra_route.rpy:446
translate es storyscene1_0a264c4d:

    # "{i}~I was always more interested in my own appearance, and if a photo was unflattering, I usually deleted it~"
    "{i}~Siempre me interesaba más mi propia apariencia, y si una foto no me favorecía, solía borrarla~"

# game/kendra_route.rpy:448
translate es storyscene1_895ae41c:

    # "{i}~Since he went to college, we’d become more like roommates who rarely spoke, than [a] and [n]~"
    "{i}~Desde que se fue a la universidad, nos habíamos vuelto más como compañeros de casa que casi no se hablan, que como [a] y [n]~"

# game/kendra_route.rpy:457
translate es storyscene1_17144299:

    # "{i}~I’d always assumed [x] would start to have more friends and go to parties once he began at MIT, but that wasn’t the case~"
    "{i}~Siempre supuse que [x] empezaría a tener más amigos e ir a fiestas una vez que entrara al MIT, pero no fue así~"

# game/kendra_route.rpy:459
translate es storyscene1_a8bc529d:

    # "{i}~Before the fight with Rachel, the boy would come home for the weekend and bury himself in his room~"
    "{i}~Antes de la pelea con Rachel, el chico venía a casa el fin de semana y se enterraba en su cuarto~"

# game/kendra_route.rpy:461
translate es storyscene1_b8486841:

    # "{i}~Lost in his studying and programming, until he came out late at night to grouse on food and then disappear again till the morning~"
    "{i}~Perdido en sus estudios y en la programación, hasta que salía tarde en la noche a devorar comida y luego desaparecía otra vez hasta la mañana~"

# game/kendra_route.rpy:465
translate es storyscene1_541cff56:

    # "{i}~A wave of emotion swept over me as I took in my gorgeous home with its bright green lawns~"
    "{i}~Una oleada de emoción me invadió al contemplar mi hermosa casa con su césped verde brillante~"

# game/kendra_route.rpy:467
translate es storyscene1_370570e1:

    # "{i}~I’d fallen in love with the place the moment I’d laid eyes on it, and after months of pestering my late husband, he’d bought it~"
    "{i}~Me había enamorado del lugar en el momento en que lo vi, y después de meses de insistirle a mi difunto esposo, lo compró~"

# game/kendra_route.rpy:469
translate es storyscene1_99433a8d:

    # "{i}~Now I’m going to lose it, I thought to myself, feeling an ache in the pit of my stomach~"
    "{i}~Ahora voy a perderla, pensé, sintiendo un dolor en la boca del estómago~"

# game/kendra_route.rpy:477
translate es storyscene1_52a5e07c:

    # "{i}~The wave of loss I felt might seem silly, but it was a combination of things that all came crashing down on me~"
    "{i}~La sensación de pérdida que sentí puede parecer tonta, pero era una combinación de cosas que se me vinieron todas encima~"

# game/kendra_route.rpy:479
translate es storyscene1_58569492:

    # "{i}~Not only had I lost my husband last year, but now I was about to lose everything else as well~"
    "{i}~No solo había perdido a mi esposo el año pasado, sino que ahora también estaba a punto de perder todo lo demás~"

# game/kendra_route.rpy:488
translate es storyscene1_dbbd775e:

    # "{i}~An hour later, I was curled up on the couch with my laptop, digging through my late husband's investments to see if there was anything worthwhile there~"
    "{i}~Una hora después, estaba acurrucada en el sofá con mi laptop, revisando las inversiones de mi difunto esposo para ver si había algo que valiera la pena~"

# game/kendra_route.rpy:490
translate es storyscene1_e885ee6d:

    # "{i}~The idiot man had emptied his 401k a decade before and been drawing from our joint mutual fund accounts for years~"
    "{i}~Ese hombre idiota había vaciado su fondo de jubilación hacía una década y llevaba años sacando dinero de nuestras cuentas conjuntas de fondos mutuos~"

# game/kendra_route.rpy:492
translate es storyscene1_46bd50b7:

    # "{i}~If I closed down all the accounts, and after fees and taxes, I might be able to cover half of the first debt payment~"
    "{i}~Si cerraba todas las cuentas, y después de comisiones e impuestos, tal vez podría cubrir la mitad del primer pago de la deuda~"

# game/kendra_route.rpy:494
translate es storyscene1_7332da7d:

    # "{i}~I was just googling what I could get if I sold my car when an email notification popped up and I clicked it without thinking~"
    "{i}~Justo estaba buscando en Google cuánto podría sacar si vendía mi auto cuando apareció una notificación de correo y le hice clic sin pensar~"

# game/kendra_route.rpy:498
translate es storyscene1_1b63d6db:

    # "From: lisa@deepweb.ne"
    "De: lisa@deepweb.ne"

# game/kendra_route.rpy:500
translate es storyscene1_7255252c:

    # "To: Kendra Beverley"
    "Para: Kendra Beverley"

# game/kendra_route.rpy:502
translate es storyscene1_04f2ff73:

    # "Re: Audition & Interview"
    "Re: Audición y entrevista"

# game/kendra_route.rpy:504
translate es storyscene1_af8628aa:

    # di "Greetings Kendra, Our mutual acquaintance offered you as a potential model for my site."
    di "Saludos, Kendra. Una conocida en común te recomendó como posible modelo para mi sitio."

# game/kendra_route.rpy:506
translate es storyscene1_a4cd28a2:

    # di "I was wondering if you are free this afternoon or evening for a brief audition and interview."
    di "Me preguntaba si estás libre esta tarde o esta noche para una breve audición y entrevista."

# game/kendra_route.rpy:509
translate es storyscene1_9695c1df:

    # di "If you are, please sign the attached non-disclosure agreement and forward it back with a time that works for you."
    di "Si es así, por favor firma el acuerdo de confidencialidad adjunto y reenvíalo con un horario que te funcione."

# game/kendra_route.rpy:511
translate es storyscene1_012031b6:

    # di "I’m sure it goes without needing to be said, but in the interest of being on the same page:"
    di "Seguramente no hace falta decirlo, pero para que estemos en la misma página:"

# game/kendra_route.rpy:514
translate es storyscene1_bae6ce8f:

    # di "If you forward this email to anyone else, or relay what we speak about, then you will find yourself in litigation."
    di "Si reenvías este correo a alguien más, o cuentas de lo que hablemos, terminarás en un juicio."

# game/kendra_route.rpy:516
translate es storyscene1_b4bcee66:

    # di "We eagerly await your response."
    di "Esperamos tu respuesta con ansias."

# game/kendra_route.rpy:518
translate es storyscene1_3e7cdeae:

    # di "Best regards, The Director."
    di "Atentamente, El Director."

# game/kendra_route.rpy:521
translate es storyscene1_99cdd2bd:

    # "{i}~I read the email a second time and then downloaded the attachment~"
    "{i}~Leí el correo por segunda vez y luego descargué el archivo adjunto~"

# game/kendra_route.rpy:523
translate es storyscene1_da42b7eb:

    # "{i}~My heart was racing as I signed the electronic document, and despite my better judgment, I felt a thrill shoot down between my legs~"
    "{i}~El corazón me latía con fuerza mientras firmaba el documento electrónico y, a pesar de mi buen juicio, sentí una descarga de excitación entre las piernas~"

# game/kendra_route.rpy:525
translate es storyscene1_8098fffc:

    # "{i}~Responding to the email, I said I just needed ten minutes to freshen up~"
    "{i}~Al responder el correo, dije que solo necesitaba diez minutos para arreglarme~"

# game/kendra_route.rpy:533
translate es storyscene1_2e0ac3d4:

    # "{i}~Feeling suddenly nervous, I jumped up and hurried to my bedroom~"
    "{i}~De pronto me sentí nerviosa, me levanté de un salto y corrí a mi cuarto~"

# game/kendra_route.rpy:542
translate es storyscene1_f6164b17:

    # "{i}~Throwing on my favorite dress, I made sure its plunging neckline showed off my assets to the best effect~"
    "{i}~Me puse mi vestido favorito y me aseguré de que su escote pronunciado mostrara mis atributos de la mejor manera~"

# game/kendra_route.rpy:546
translate es storyscene1_2897deaa:

    # "{i}~Then I popped in front of the mirror and touched up my mascara and eyeliner~"
    "{i}~Luego me paré frente al espejo y me retoqué el rímel y el delineador~"

# game/kendra_route.rpy:548
translate es storyscene1_ad4145b2:

    # "{i}~After giving my hair a tease and making sure it hung artfully around my neck, I went back to the living room~"
    "{i}~Después de darme un poco de volumen en el pelo y asegurarme de que cayera con gracia alrededor de mi cuello, volví a la sala~"

# game/kendra_route.rpy:556
translate es storyscene1_5525f6ef:

    # "{i}~By the time I sat down and pulled up my laptop, there was a response from The Director, this time with a hyperlink~"
    "{i}~Cuando me senté y abrí mi laptop, ya había una respuesta de El Director, esta vez con un enlace~"

# game/kendra_route.rpy:558
translate es storyscene1_3311e4b3:

    # "{i}~Feeling butterflies in my stomach, I double-checked my appearance and then clicked the link~"
    "{i}~Con mariposas en el estómago, revisé dos veces mi apariencia y luego hice clic en el enlace~"

# game/kendra_route.rpy:560
translate es storyscene1_b7481971:

    # "{i}~The link didn’t have a .com at the end of it. Instead, it had three letters I’d never seen together before~"
    "{i}~El enlace no terminaba en .com. En cambio, tenía tres letras que nunca había visto juntas~"

# game/kendra_route.rpy:564
translate es storyscene1_ca37add2:

    # "{i}~My browser opened and instantly became full black screen without any input on my end, then the light of my webcam popped on, without the usual dialog box asking me if it was ok~"
    "{i}~Mi navegador se abrió y al instante la pantalla se puso completamente negra sin que yo tocara nada, luego se encendió la luz de mi cámara web, sin el cuadro de diálogo habitual que pregunta si está bien~"

# game/kendra_route.rpy:566
translate es storyscene1_d14c9069:

    # "{i}~I was so disturbed by the dark screen and live webcam that I nearly closed the computer and shoved it aside~"
    "{i}~Me perturbó tanto la pantalla oscura y la cámara web encendida que casi cerré la computadora y la hice a un lado~"

# game/kendra_route.rpy:568
translate es storyscene1_a8b78148:

    # "{i}~Reminding myself that if I didn’t find money soon, I might be without a home in a couple weeks~"
    "{i}~Recordándome que si no encontraba dinero pronto, podría quedarme sin casa en un par de semanas~"

# game/kendra_route.rpy:570
translate es storyscene1_259ee0fd:

    # "{i}~I took a firm grip on my nerves and pushed them down, just like when I used to get stage fright in my modeling days; the butterflies faded after slow deep breaths~"
    "{i}~Me controlé los nervios con firmeza y los contuve, igual que cuando me daba miedo escénico en mis días de modelo; las mariposas se calmaron tras respirar lento y profundo~"

# game/kendra_route.rpy:578
translate es storyscene1_e223ba7d:

    # "{i}~Just as I was calming down, text scrolled up from the bottom of the screen~"
    "{i}~Justo cuando me estaba calmando, un texto empezó a subir desde la parte inferior de la pantalla~"

# game/kendra_route.rpy:580
translate es storyscene1_dd33fa39:

    # di "Greetings Kendra Beverley and our sorrow for your loss."
    di "Saludos, Kendra Beverley, y nuestro pésame por tu pérdida."

# game/kendra_route.rpy:582
translate es storyscene1_eb259f43:

    # k "Thank you…{size=26}{i}{color=#A9A9A9}~I said, unsure if they could hear me~"
    k "Gracias…{size=26}{i}{color=#A9A9A9}~dije, sin estar segura de si podían escucharme~"

# game/kendra_route.rpy:584
translate es storyscene1_d57c8268:

    # di "We are an exclusive agency that handles customers with particular tastes. We provide our customers with a… peek into their greatest fantasies."
    di "Somos una agencia exclusiva que atiende a clientes con gustos particulares. Les ofrecemos a nuestros clientes una… mirada a sus fantasías más grandes."

# game/kendra_route.rpy:586
translate es storyscene1_7277d119:

    # di "We take this work very seriously and, as such, must ensure that our models are of the finest quality and the… experience they undergo, one that is as authentic as possible."
    di "Nos tomamos este trabajo muy en serio y, por eso, debemos asegurarnos de que nuestras modelos sean de la mejor calidad y de que la… experiencia que vivan sea lo más auténtica posible."

# game/kendra_route.rpy:595
translate es storyscene1_e82c7e87:

    # k "Ok… but that doesn’t really tell me anything."
    k "Ok… pero eso no me dice nada realmente."

# game/kendra_route.rpy:597
translate es storyscene1_a87aa159:

    # "{i}~Feeling very awkward speaking to a black screen with white letters scrolling up it~"
    "{i}~Me sentía muy incómoda hablando con una pantalla negra con letras blancas subiendo por ella~"

# game/kendra_route.rpy:599
translate es storyscene1_1a7add17:

    # di "You will be given instructions if you’re deemed of suitable beauty. Please set the computer on a lower surface and remove your clothing."
    di "Recibirás instrucciones si se determina que tienes la belleza adecuada. Por favor, pon la computadora en una superficie más baja y quítate la ropa."

# game/kendra_route.rpy:608
translate es storyscene1_d14cf62f:

    # "{i}~I felt indignant for one second, then remembered working with asshole photographers over the years~"
    "{i}~Me sentí indignada por un segundo, luego recordé haber trabajado con fotógrafos imbéciles a lo largo de los años~"

# game/kendra_route.rpy:610
translate es storyscene1_313d4f70:

    # "{i}~Men and women who had seen so many beautiful people they’d become inured to it~"
    "{i}~Hombres y mujeres que habían visto a tanta gente hermosa que se habían vuelto insensibles a ello~"

# game/kendra_route.rpy:612
translate es storyscene1_3add3ad9:

    # "{i}~They often dealt with talent, just like whoever was on the other end of the chat did, brusque, assuming they were dealing with a foolish model~"
    "{i}~A menudo trataban al talento, igual que quienquiera que estuviera al otro lado del chat, con brusquedad, asumiendo que trataban con una modelo tonta~"

# game/kendra_route.rpy:621
translate es storyscene1_a34bc046:

    # "{i}~I’d already decided that I would do just about anything to save my home, so I stood, pushing down my nerves and set the computer on the table~"
    "{i}~Ya había decidido que haría casi cualquier cosa para salvar mi casa, así que me levanté, contuve los nervios y puse la computadora sobre la mesa~"

# game/kendra_route.rpy:630
translate es storyscene1_461128f0:

    # "{i}~Standing before the webcam, I began to strip down~"
    "{i}~Parada frente a la cámara web, empecé a desvestirme~"

# game/kendra_route.rpy:632
translate es storyscene1_c61f69a3:

