    # x "Hello [a!c] Kendra."
    x "Hola, [a!c] Kendra."

# game/kendra_route.rpy:2129
translate es storyscene2_1168fc79:

    # x "Is everything alright?"
    x "¿Está todo bien?"

# game/kendra_route.rpy:2137
translate es storyscene2_45438afa:

    # "{i}~I felt terrible instantly, I wasn’t angry with him, and he certainly didn’t deserve to be the brunt of my anger~"
    "{i}~Me sentí terrible al instante, no estaba enojada con él, y desde luego él no merecía cargar con mi enojo~"

# game/kendra_route.rpy:2139
translate es storyscene2_1cbf2fa2:

    # k "I’m sorry [x], I’m just a little stressed today."
    k "Perdón, [x], hoy estoy un poco estresada."

# game/kendra_route.rpy:2145
translate es storyscene2_3035a38f:

    # x "Don't worry [a], everybody got a bad day sometimes."
    x "No te preocupes, [a], todo el mundo tiene un mal día a veces."

# game/kendra_route.rpy:2153
translate es storyscene2_fcc8885b:

    # "{i}~When I looked up, I was arrested by the calm understanding in his pale brown eyes~"
    "{i}~Cuando levanté la vista, me quedé atrapada por la calma y comprensión en sus ojos marrón claro~"

# game/kendra_route.rpy:2155
translate es storyscene2_f1f8930d:

    # k "You’re so sweet, [x]."
    k "Eres tan dulce, [x]."

# game/kendra_route.rpy:2160
translate es storyscene2_6efa1530:

    # x "It's Ok, don't worry."
    x "Está bien, no te preocupes."

# game/kendra_route.rpy:2168
translate es storyscene2_5decef37:

    # x "You look lovely today, [a]."
    x "Te ves hermosa hoy, [a]."

# game/kendra_route.rpy:2170
translate es storyscene2_caaeb2d9:

    # k "Thank you [x], you’re so sweet."
    k "Gracias, [x], eres tan dulce."

# game/kendra_route.rpy:2175
translate es storyscene2_6efa1530_1:

    # x "It's Ok, don't worry."
    x "Está bien, no te preocupes."

# game/kendra_route.rpy:2183
translate es storyscene2_6fbadaef:

    # x "I like the outfit [a], you look sexy."
    x "Me gusta el atuendo, [a], te ves sexy."

# game/kendra_route.rpy:2192
translate es storyscene2_a26158bf:

    # k "Sexy?"
    k "¿Sexy?"

# game/kendra_route.rpy:2194
translate es storyscene2_73c20d80:

    # k "Ehm, you think so?"
    k "Ehm, ¿eso crees?"

# game/kendra_route.rpy:2196
translate es storyscene2_583d4206:

    # x "Yes, very much."
    x "Sí, mucho."

# game/kendra_route.rpy:2198
translate es storyscene2_17e4bc19:

    # k "Thank you, [x]."
    k "Gracias, [x]."

# game/kendra_route.rpy:2202
translate es storyscene2_3f8fc22e:

    # "{i}~Feeling a swelling of affection for the boy and pulling him into a one-armed hug~"
    "{i}~Sentí una oleada de cariño por el chico y lo atraje hacia un abrazo con un brazo~"

# game/kendra_route.rpy:2204
translate es storyscene2_be576ad1:

    # "{i}~I don’t know if it was the wine, or the golden morning light, but in that moment, my [n] was the most handsome man I’d ever seen~"
    "{i}~No sé si fue el vino o la luz dorada de la mañana, pero en ese momento, mi [n] era el hombre más guapo que había visto~"

# game/kendra_route.rpy:2212
translate es storyscene2_cc6504a8:

    # "{i}~It was his lips that trapped my gaze and I found myself leaning forward, as if to kiss them, and jerked back in surprise~"
    "{i}~Fueron sus labios los que atraparon mi mirada y me encontré inclinándome hacia adelante, como para besarlos, y me eché atrás de golpe, sorprendida~"

# game/kendra_route.rpy:2221
translate es storyscene2_26c1d6ec:

    # k "I’m sorry."
    k "Perdón."

# game/kendra_route.rpy:2223
translate es storyscene2_8f7a2c85:

    # k "I didn’t mean to…"
    k "No quise…"

# game/kendra_route.rpy:2227
translate es storyscene2_cdfb25bf:

    # "{i}~[x]’s gentle fingers pulled my face back over and I was looking deep into his beautiful brown eyes~"
    "{i}~Los dedos suaves de [x] volvieron a girar mi cara y quedé mirando profundamente sus hermosos ojos marrones~"

# game/kendra_route.rpy:2229
translate es storyscene2_70ac35ba:

    # "{i}~They twinkled with amusement, but also something deeper. A hunger within him that I mirrored, but he didn’t have my fear or hesitation~"
    "{i}~Brillaban con diversión, pero también con algo más profundo. Un hambre dentro de él que yo reflejaba, pero él no tenía mi miedo ni mi vacilación~"

# game/kendra_route.rpy:2231
translate es storyscene2_fec19dda:

    # x "Everything, okay?"
    x "¿Todo bien?"

# game/kendra_route.rpy:2239
translate es storyscene2_246f48b5:

    # k "No,"
    k "No,"

# game/kendra_route.rpy:2241
translate es storyscene2_5da7d485:

    # k "But it’s always better when you’re there."
    k "Pero siempre es mejor cuando estás ahí."

# game/kendra_route.rpy:2251
translate es storyscene2_12a35115:

    # x "Is it because of what happened with me and Linda?"
    x "¿Es por lo que pasó entre Linda y yo?"

# game/kendra_route.rpy:2253
translate es storyscene2_4037764c:

    # "{i}~He asked softly, his eyes flickering around to make sure we were alone~"
    "{i}~Preguntó en voz baja, mirando a su alrededor para asegurarse de que estábamos solos~"

# game/kendra_route.rpy:2255
translate es storyscene2_661fedd7:

    # k "Don’t worry about it."
    k "No te preocupes por eso."

# game/kendra_route.rpy:2260
translate es kendracontinue_a977b31c:

    # "{i}~I said and tried to release him, but [x] held me fast, eyes searching mine until I felt the dam within me burst~"
    "{i}~Dije y traté de soltarlo, pero [x] me sostuvo con firmeza, buscando mi mirada hasta que sentí que el dique dentro de mí se rompía~"

# game/kendra_route.rpy:2262
translate es kendracontinue_118d199b:

    # x "I couldn't live with myself if I did something to hurt your or [m]’s feelings..."
    x "No podría vivir conmigo mismo si hiciera algo que hiriera tus sentimientos o los de [m]…"

# game/kendra_route.rpy:2264
translate es kendracontinue_395b3334:

    # "{i}~[x] didn’t offer words of comfort or reassurance because he didn't know what I was going through~"
    "{i}~[x] no ofreció palabras de consuelo ni de aliento, porque no sabía por lo que yo estaba pasando~"

# game/kendra_route.rpy:2266
translate es kendracontinue_f8c08a6b:

    # "{i}~But he did hold me, offering a silent reminder that no matter what happened he’d be there right beside me~"
    "{i}~Pero sí me abrazó, ofreciéndome un recordatorio silencioso de que, pasara lo que pasara, él estaría ahí, justo a mi lado~"

# game/kendra_route.rpy:2269
translate es kendracontinue_575e3748:

    # k "You’ve grown up a lot since I last saw you [x]."
    k "Has crecido mucho desde la última vez que te vi, [x]."

# game/kendra_route.rpy:2271
translate es kendracontinue_b75ded94:

    # k "And you’re still changing, still growing into a great man. Those gifts come with weaknesses and drawbacks, remember that."
    k "Y sigues cambiando, sigues convirtiéndote en un gran hombre. Esos dones vienen con debilidades y desventajas, recuérdalo."

# game/kendra_route.rpy:2273
translate es kendracontinue_5ab04530:

    # x "I don’t think we have to worry about that now..."
    x "No creo que tengamos que preocuparnos por eso ahora..."

# game/kendra_route.rpy:2280
translate es kendracontinue_c78e17af:

    # "{i}~His lips pressed against mine, and I stiffened in shock, then melted in pleasure~"
    "{i}~Sus labios se presionaron contra los míos, y me quedé rígida por la impresión, luego me derretí de placer~"

# game/kendra_route.rpy:2283
translate es kendracontinue_54ef98d3:

    # "{i}~Our kiss was gentle, just a touching of lips to lips, but the emotions that leaped up within me had my fingers and legs trembling~"
    "{i}~Nuestro beso fue suave, solo un roce de labios contra labios, pero las emociones que brotaron dentro de mí me hicieron temblar los dedos y las piernas~"

# game/kendra_route.rpy:2285
translate es kendracontinue_f72a861a:

    # "{i}~I felt his hand grabing the top of my jacket as he started to take it off~"
    "{i}~Sentí su mano agarrar la parte superior de mi chaqueta cuando empezó a quitármela~"

# game/kendra_route.rpy:2293
translate es kendracontinue_e6d17349:

    # "{i}~Our chests were rising and falling heavily and I felt a wild energy coursing through me~"
    "{i}~Nuestros pechos subían y bajaban con fuerza y sentí una energía salvaje corriendo por mí~"

# game/kendra_route.rpy:2302
translate es kendracontinue_970da14f:

    # "{i}~He pressed me against him, squeezed my ass and kissed me passionately, before I pulled back~"
    "{i}~Me apretó contra él, me apretó el trasero y me besó apasionadamente, antes de que yo me apartara~"

# game/kendra_route.rpy:2306
translate es kendracontinue_436436d2:

    # "{i}~And slapped him across the face, his eyes wide with the same shock I felt~"
    "{i}~Y le di una cachetada en la cara, con sus ojos muy abiertos por la misma impresión que yo sentía~"

# game/kendra_route.rpy:2309
translate es kendracontinue_8850d49b:

    # k "What are you doing?!"
    k "¿Qué estás haciendo?"

# game/kendra_route.rpy:2311
translate es kendracontinue_78b2ec88:

    # x "That was... unexpected."
    x "Eso fue... inesperado."

# game/kendra_route.rpy:2319
translate es kendracontinue_df14cca7:

    # k "And what did you expect, [x]?! I’m your [a]!"
    k "¿Y qué esperabas, [x]? ¡Soy tu [a]!"

# game/kendra_route.rpy:2321
translate es kendracontinue_087b53a5:

    # k "What's wrong with you?!"
    k "¿Qué te pasa?"

# game/kendra_route.rpy:2330
translate es kendracontinue_9e7663f3:

    # x "Perhaps I should go..."
    x "Quizás debería irme..."

# game/kendra_route.rpy:2339
translate es kendracontinue_95f10474:

    # "{i}~When he turned to go, I took his hand~"
    "{i}~Cuando se dio la vuelta para irse, le tomé la mano~"

# game/kendra_route.rpy:2341
translate es kendracontinue_9bd0fded:

    # k "[x], wait."
    k "[x], espera."

# game/kendra_route.rpy:2345
translate es kendracontinue_7eacac10:

    # k "That was..."
    k "Eso fue..."

# game/kendra_route.rpy:2347
translate es kendracontinue_57056b75:

    # k "I’ve never done that before... with... I’m sorry if..."
    k "Nunca había hecho eso antes... con... Perdón si..."

# game/kendra_route.rpy:2355
translate es kendracontinue_c7aee4e0:

    # x "No, you have nothing to apologize about."
    x "No, no tienes nada por qué disculparte."

# game/kendra_route.rpy:2357
translate es kendracontinue_138c0d48:

    # x "I have a habit of rushing things and I don’t want to ruin our relationship."
    x "Tengo la costumbre de apresurar las cosas y no quiero arruinar nuestra relación."

# game/kendra_route.rpy:2359
translate es kendracontinue_0b336c56:

    # x "Please don’t tell [m]… I’m sorry."
    x "Por favor, no le digas a [m]… Perdón."

# game/kendra_route.rpy:2363
translate es kendracontinue_417490b1:

    # k "Let’s just forget about this..."
    k "Mejor olvidemos esto..."

# game/kendra_route.rpy:2365
translate es kendracontinue_3a9e2445:

    # k "Let’s order some food, please."
    k "Pidamos algo de comer, por favor."

# game/kendra_route.rpy:2367
translate es kendracontinue_6715a9b4:

    # k "And I thinks it’s better to put my jacket back on before Rachel comes back home."
    k "Y creo que es mejor que vuelva a ponerme la chaqueta antes de que Rachel vuelva a casa."

# game/kendra_route.rpy:2371
translate es kendracontinue_be96ce45:

    # x "Let’s order some food."
    x "Pidamos algo de comer."

# game/kendra_route.rpy:2379
translate es kendracontinue_ddab30f2:

    # "{i}~I caught his eyes bobbing down to stare for a moment at the massive swell of my chest before he turned away quickly and called the pizza place~"
    "{i}~Vi cómo sus ojos bajaban para mirar por un momento la enorme prominencia de mi pecho antes de que se diera la vuelta rápidamente y llamara a la pizzería~"

# game/kendra_route.rpy:2388
translate es kendracontinue_a471ad73:

    # "{i}~20 minutes later we were in the kitchen with the pizza~"
    "{i}~20 minutos después estábamos en la cocina con la pizza~"

# game/kendra_route.rpy:2390
translate es kendracontinue_d2591402:

    # x "How have you been this last year? What's new?"
    x "¿Cómo has estado este último año? ¿Qué hay de nuevo?"

# game/kendra_route.rpy:2399
translate es kendracontinue_ed932887:

    # k "I might have found an agency that’s willing to take me back on as a model."
    k "Quizás encontré una agencia que está dispuesta a aceptarme de nuevo como modelo."

# game/kendra_route.rpy:2401
translate es kendracontinue_a27c01ce:

    # x "Really? You don’t talk about you’re modeling days much..."
    x "¿En serio? No hablas mucho de tus épocas de modelo..."

# game/kendra_route.rpy:2403
translate es kendracontinue_0851f9bd:

    # x "Is it really as crazy as all the stories make it out to be?"
    x "¿De verdad es tan loco como lo pintan todas esas historias?"

# game/kendra_route.rpy:2412
translate es kendracontinue_114e7dee:

    # k "You mean the drugs, sex, and all that?"
    k "¿Te refieres a las drogas, el sexo y todo eso?"

# game/kendra_route.rpy:2414
translate es kendracontinue_36be93a5:

    # "{i}~I asked with a crooked grin, taking a sip of my wine and almost laughing as the boy squirmed on his seat~"
    "{i}~Pregunté con una sonrisa torcida, tomando un sorbo de mi vino y casi riéndome al ver al chico retorcerse en su asiento~"

# game/kendra_route.rpy:2423
translate es kendracontinue_8df25631:

    # k "Not when I first got in, I think I was too young to really get involved in all that."
    k "No cuando empecé; creo que era demasiado joven para meterme de verdad en todo eso."

# game/kendra_route.rpy:2425
translate es kendracontinue_8cba4cd4:

    # k "It certainly existed but was mostly at the clubs."
    k "Claro que existía, pero pasaba sobre todo en los clubes."

# game/kendra_route.rpy:2427
translate es kendracontinue_30333fbf:

    # k "There might have been one or two crazy nights in my early twenties, but I wasn’t as bad as some of the other girls and guys."
    k "Puede que haya tenido una o dos noches locas a principios de mis veinte, pero no era tan descontrolada como algunas de las otras chicas y chicos."

# game/kendra_route.rpy:2436
translate es kendracontinue_c23e316e:

    # "{i}~He continued to probe me with questions about those early years in Europe, so I told him about the disco techs with their greasy men and wild women~"
    "{i}~Siguió haciéndome preguntas sobre esos primeros años en Europa, así que le conté de las discotecas con sus hombres grasientos y sus mujeres alocadas~"

# game/kendra_route.rpy:2438
translate es kendracontinue_55a4d270:

    # "{i}~Of trips on yachts where I worked, just hanging out on a deck and sunbathing with a dozen other women~"
    "{i}~De viajes en yates donde trabajaba, simplemente tirada en una cubierta tomando el sol con una docena de mujeres más~"

# game/kendra_route.rpy:2440
translate es kendracontinue_f5e7cb3c:

    # k "I'm curious... if you were that rich, would you would hire a bunch of gorgeous women just to lay around and stare at?"
    k "Tengo curiosidad... si fueras así de rico, ¿contratarías a un montón de mujeres hermosas solo para que estén tiradas por ahí y mirarlas?"

# game/kendra_route.rpy:2445
translate es kendracontinue_f4f55810:

    # x "Maybe I already have a mansion full of gorgeous women."
    x "Quizás ya tengo una mansión llena de mujeres hermosas."

# game/kendra_route.rpy:2454
translate es kendracontinue_0175fb02:

    # k "Is that what men want?"
    k "¿Eso es lo que quieren los hombres?"

# game/kendra_route.rpy:2456
translate es kendracontinue_fbb22a8e:

    # "{i}~I asked and felt tension grow in the room~"
    "{i}~Pregunté y sentí cómo crecía la tensión en la habitación~"

# game/kendra_route.rpy:2458
translate es kendracontinue_1f09a184:

    # x "Yes."
    x "Sí."

# game/kendra_route.rpy:2467
translate es kendracontinue_622b3a8e:

    # "{i}~His simple answer stuned me, and I stood there for several long seconds with a thoughtful look on my face~"
    "{i}~Su respuesta tan simple me dejó atónita, y me quedé ahí parada varios segundos largos con expresión pensativa~"

# game/kendra_route.rpy:2469
translate es kendracontinue_f50a7100:

    # x "Women also respond favorably to a man who knows what he wants and takes it."
    x "Las mujeres también responden bien a un hombre que sabe lo que quiere y lo toma."

