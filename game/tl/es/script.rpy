# game/script.rpy:610
translate es start_bf0a8e83:

    # "{i}~Finally, the car pulled to a stop before a large brick building with no signs or markings to identify it~"
    "{i}~Finalmente, el auto se detuvo frente a un gran edificio de ladrillos sin letreros ni marcas que lo identificaran~"

# game/script.rpy:618
translate es start_bdf4f8b5:

    # "{i}~Nicole came around and opened the door and I climbed out, feeling the wind whip through my thin jacket~"
    "{i}~Nicole dio la vuelta y abrió la puerta y yo salí, sintiendo el viento azotar mi chaqueta delgada~"

# game/script.rpy:620
translate es start_94f46cc5:

    # "{i}~I glanced up and down the street and saw old law offices and financial firms, housed in businesses that dated back to before the turn of the century or even to before the founding of the republic~"
    "{i}~Miré calle arriba y abajo y vi viejas oficinas de abogados y firmas financieras, alojadas en negocios que databan de antes del cambio de siglo o incluso de antes de la fundación de la república~"

# game/script.rpy:629
translate es start_4819a517:

    # n "You can head on in Young Master."
    n "Puede entrar, Joven Amo."

# game/script.rpy:631
translate es start_7c39f5a1:

    # n "They are expecting you."
    n "Lo están esperando."

# game/script.rpy:633
translate es start_819a07b0:

    # x "Please, just call me [x]."
    x "Por favor, llámame simplemente [x]."

# game/script.rpy:642
translate es start_dcf67a85:

    # n "Very well, Young Master [x]."
    n "Muy bien, Joven Amo [x]."

# game/script.rpy:651
translate es start_fae857b4:

    # "{i}~I sighed and walked up the steps and pushed open the heavy green door~"
    "{i}~Suspiré, subí los escalones y empujé la pesada puerta verde~"

# game/script.rpy:660
translate es start_f84a408e:

    # "{i}~Within I found a nice cozy waiting room with a desk in one corner. A pretty young woman sat behind it, and she leaped to her feet when I stepped in~"
    "{i}~Adentro encontré una sala de espera bonita y acogedora con un escritorio en una esquina. Una joven hermosa estaba sentada detrás de él, y se puso de pie de un salto cuando entré~"

# game/script.rpy:673
translate es start_90b1fc2c:

    # "{i}~She smoothed down her tight dress and pushed back her thick dark hair and gave me a large winning smile~"
    "{i}~Se alisó el vestido ajustado, se echó hacia atrás su espeso cabello oscuro y me dedicó una gran sonrisa encantadora~"

# game/script.rpy:675
translate es start_2d21ab1e:

    # m "Young Master Sussex!"
    m "¡Joven Amo Sussex!"

# game/script.rpy:677
translate es start_ae868524:

    # "{i}~She walked around her desk and I saw she wore a narrow pencil dress and high heels that showed off her legs wonderfully~"
    "{i}~Rodeó su escritorio y vi que llevaba un vestido lápiz estrecho y tacones altos que resaltaban sus piernas de maravilla~"

# game/script.rpy:686
translate es start_9fe3268b:

    # "{i}~I did my best to ignore her hourglass beauty and the perfume that wafted off her, like sweet summer flowers, as she pulled open a side door, showing a staircase that led up~"
    "{i}~Hice lo mejor que pude para ignorar su belleza de reloj de arena y el perfume que emanaba de ella, como dulces flores de verano, mientras abría una puerta lateral que mostraba una escalera que subía~"

# game/script.rpy:688
translate es start_4ecb229f:

    # m "I am Megan. Please follow me and I will show you up."
    m "Soy Megan. Por favor, sígame y lo llevaré arriba."

# game/script.rpy:690
translate es start_91be2ab0:

    # x "Thank you.{size=26}{i}{color=#A9A9A9}~I said, glancing around curiously as I made my way over~"
    x "Gracias.{size=26}{i}{color=#A9A9A9}~dije, mirando a mi alrededor con curiosidad mientras me acercaba~"

# game/script.rpy:699
translate es start_06b53fd9:

    # m "Have you ever been in a colonial building before?"
    m "¿Ha estado antes en un edificio colonial?"

# game/script.rpy:701
translate es start_b64cc173:

    # x "No. Is this building really that old?"
    x "No. ¿Este edificio es realmente tan antiguo?"

# game/script.rpy:710
translate es start_9559f678:

    # m "Yes, it’s one of the oldest in the city, both it and the surrounding property have been in the Sussex family for centuries now."
    m "Sí, es uno de los más antiguos de la ciudad, tanto él como la propiedad que lo rodea han pertenecido a la familia Sussex desde hace siglos."

# game/script.rpy:712
translate es start_7d6e7edd:

    # m "Unfortunately, the rest of the block was torn down many decades ago to make way for more modern construction, but your Great Uncle had this building designated as a historical landmark."
    m "Desafortunadamente, el resto de la manzana fue demolido hace muchas décadas para dar paso a construcciones más modernas, pero su tío abuelo hizo que este edificio fuera declarado monumento histórico."

# game/script.rpy:714
translate es start_e4054fd7:

    # x "So, my uncle owned property in the city?"
    x "Entonces, ¿mi tío tenía propiedades en la ciudad?"

# game/script.rpy:723
translate es start_527d8216:

    # m "He did..."
    m "Así es..."

# game/script.rpy:732
translate es start_a45fd9e5:

    # m "You will learn today that there were many things about your great uncle's life..."
    m "Hoy descubrirá que había muchas cosas sobre la vida de su tío abuelo..."

# game/script.rpy:734
translate es start_ac7dfbf3:

    # "{i}~Her eyes searched mine, looking for what I had no idea~"
    "{i}~Sus ojos buscaron los míos, buscando algo que no tenía ni idea de qué era~"

# game/script.rpy:736
translate es start_d0cf5074:

    # m "We only ask that you keep an open mind. His work was very important, and we believe you are the perfect man to continue it."
    m "Solo le pedimos que mantenga la mente abierta. Su trabajo era muy importante, y creemos que usted es el hombre perfecto para continuarlo."

# game/script.rpy:738
translate es start_ae94a897:

    # x "His work?"
    x "¿Su trabajo?"

# game/script.rpy:747
translate es start_90957af4:

    # m "Miss Bain and Miss Cohn will have to inform you of all the work your uncle was doing."
    m "La señorita Bain y la señorita Cohn tendrán que informarle de todo el trabajo que su tío estaba haciendo."

# game/script.rpy:749
translate es start_49fafd22:

    # "{i}~Her smile was warm as she gazed at me, and I felt a little uncomfortable at the way her eyes lit with an emotion I didn’t recognize~"
    "{i}~Su sonrisa era cálida mientras me miraba, y me sentí un poco incómodo por la forma en que sus ojos se iluminaron con una emoción que no reconocí~"

# game/script.rpy:758
translate es start_1ed60bb3:

    # "{i}~She took a half step up to me and I saw her wet her bottom lip with her tongue before biting it, some internal struggle going on in her~"
    "{i}~Dio medio paso hacia mí y la vi humedecerse el labio inferior con la lengua antes de morderlo, con alguna lucha interna ocurriendo dentro de ella~"

# game/script.rpy:767
translate es start_8fb9c959:

    # "{i}~Then to my great surprise, she pulled me into a firm hug, and I was all too aware of her big firm breasts and soft body pressing against me~"
    "{i}~Entonces, para mi gran sorpresa, me atrajo hacia un abrazo firme, y fui demasiado consciente de sus grandes tetas firmes y su cuerpo suave presionándose contra mí~"

# game/script.rpy:769
translate es start_44085a87:

    # m "I am so excited for you to become our new lord."
    m "Estoy tan emocionada de que se convierta en nuestro nuevo señor."

# game/script.rpy:771
translate es start_cf034ccb:

    # "{i}~My awkward grip held her loosely, trying to shift my hips to the side, so she couldn’t feel my rapidly firming manhood~"
    "{i}~Mi abrazo torpe la sostenía sin apretar, tratando de mover mis caderas hacia un lado para que no sintiera mi hombría endureciéndose rápidamente~"

# game/script.rpy:780
translate es start_fb9f5096:

    # m "I pray you to accept the proposal."
    m "Le ruego que acepte la propuesta."

# game/script.rpy:782
translate es start_ca1f2bb3:

    # "{i}~Leaning back she looked me deep in the eyes, hers holding a smouldering promise that both excited and unnerved me~"
    "{i}~Apartándose, me miró profundo a los ojos, los suyos con una promesa ardiente que me excitaba y me inquietaba a la vez~"

# game/script.rpy:784
translate es start_1ff1f4f2:

    # m "Without you, we will all be lost, the world will be lost."
    m "Sin usted, todos estaremos perdidos, el mundo estará perdido."

# game/script.rpy:793
translate es start_8925c1d6:

    # "{i}~She saw my look of unease and her grin deepened as she kissed me on one cheek, her soft thick lips burning where they came in contact with my skin~"
    "{i}~Vio mi expresión de incomodidad y su sonrisa se amplió mientras me besaba en una mejilla, sus labios suaves y gruesos quemando donde tocaron mi piel~"

# game/script.rpy:802
translate es start_5855b8ff:

    # "{i}~Then she stepped back, smoothing out her dress, and gave me a sly wink~"
    "{i}~Luego dio un paso atrás, alisándose el vestido, y me guiñó un ojo con picardía~"

# game/script.rpy:812
translate es start_c6dcc3ef:

    # "{i}~Before pulling the two doors open and stepping back with a small bow~"
    "{i}~Antes de abrir las dos puertas y retroceder con una pequeña reverencia~"

# game/script.rpy:816
translate es start_5e6b7362:

    # "{i}~The room opened up into a massive gala with a table in the middle of the room~"
    "{i}~La habitación se abría a un enorme salón con una mesa en el centro~"

# game/script.rpy:828
translate es start_cdf54dde:

    # "{i}~There were two woman each dressed similar to Megan in form-fitting dresses~"
    "{i}~Había dos mujeres, cada una vestida de forma similar a Megan, con vestidos ceñidos al cuerpo~"

# game/script.rpy:830
translate es start_372612ba:

    # "{i}~Each was beautiful and older, clearly in their late forties but with an elegance and self-assurance that spoke volumes about them~"
    "{i}~Cada una era hermosa y mayor, claramente rondando los cincuenta, pero con una elegancia y seguridad que decían mucho de ellas~"

# game/script.rpy:839
translate es start_3bb6130a:

    # "{i}~They each came out and walked to the middle of the room, where a low table and two chairs had been set up, along with a stack of paperwork~"
    "{i}~Cada una salió y caminó hasta el centro de la habitación, donde habían colocado una mesa baja y dos sillas, junto con una pila de papeles~"

# game/script.rpy:868
translate es start_8b94e672:

    # "{i}~One was clearly Megan's [m1], each had the same thick dark hair, cut in a similar fashion~"
    "{i}~Una era claramente la [m1] de Megan, ambas tenían el mismo cabello oscuro y espeso, cortado de forma similar~"

# game/script.rpy:870
translate es start_af28cc6e:

    # "{i}~The woman was thick and curvy, with the same black-framed glasses as Megan and her black hair styled in waves full of body and bounce as she moved~"
    "{i}~La mujer era voluptuosa y con curvas, con las mismas gafas de marco negro que Megan y su cabello negro peinado en ondas con mucho volumen y movimiento al caminar~"

# game/script.rpy:882
translate es start_e3de50d4:

    # "{i}~The other woman had thick red lips and bright blue eyes framed by long lashes. A heavy bust and wide hip dominated her curvy form~"
    "{i}~La otra mujer tenía labios rojos y gruesos y ojos azules brillantes enmarcados por largas pestañas. Un busto abundante y caderas anchas dominaban su figura curvilínea~"

# game/script.rpy:891
translate es start_375f0a74:

    # l "Young Master [x], welcome to our offices."
    l "Joven Amo [x], bienvenido a nuestras oficinas."

# game/script.rpy:893
translate es start_9850249e:

    # l "Megan, thank you, that will be all."
    l "Megan, gracias, eso será todo."

# game/script.rpy:902
translate es start_cdcf3cd9:

    # "{i}~The younger woman gave a brief bow and backed out of the room, closing the door gently behind herself~"
    "{i}~La mujer más joven hizo una breve reverencia y salió retrocediendo de la habitación, cerrando la puerta suavemente tras ella~"

# game/script.rpy:911
translate es start_6a1e6110:

    # "{i}~The glance she sent me just as the door closed unnerved me, I’d never had a woman look at me that way before and I had no idea what it meant~"
    "{i}~La mirada que me lanzó justo cuando la puerta se cerró me inquietó, nunca una mujer me había mirado así antes y no tenía idea de qué significaba~"

# game/script.rpy:915
translate es start_a7af6751:

    # l "I am Lisa Bain,"
    l "Soy Lisa Bain,"

# game/script.rpy:917
translate es start_8e4c62c9:

    # l "And this is Linda Cohn. We represented your Great Uncle in his estate and business ventures."
    l "Y ella es Linda Cohn. Representábamos a su tío abuelo en su patrimonio y sus negocios."

# game/script.rpy:925
translate es start_257223c1:

    # li "It is a pleasure to meet you Young Master [x].{size=26}{i}{color=#A9A9A9}~the blonde said in a voice like warm brandy over ice~"
    li "Es un placer conocerlo, Joven Amo [x].{size=26}{i}{color=#A9A9A9}~dijo la rubia con una voz como brandy cálido sobre hielo~"

# game/script.rpy:934
translate es start_eecafce3:

    # li "Please, have a seat."
    li "Por favor, tome asiento."

# game/script.rpy:938
translate es start_819a07b0_1:

    # x "Please, just call me [x]."
    x "Por favor, llámame simplemente [x]."

# game/script.rpy:940
translate es start_c4037417:

    # x "All this Young Master stuff is a little weird."
    x "Todo esto del Joven Amo es un poco raro."

# game/script.rpy:948
translate es start_cb7568a6:

    # li "Sir,"
    li "Señor,"

# game/script.rpy:950
translate es start_00f02494:

    # "{i}~Linda glanced at Lisa who nodded before she continued~"
    "{i}~Linda miró a Lisa, quien asintió antes de que ella continuara~"

# game/script.rpy:959
translate es start_0a992e30:

    # li "Unfortunately the will was most explicit in certain...regards."
    li "Desafortunadamente, el testamento fue muy explícito en ciertos... aspectos."

# game/script.rpy:961
translate es start_74a21fc5:

    # li "If you chose to accept the burden of your Great Uncles holdings then you, of course, can change the terms of address..."
    li "Si elige aceptar la carga de las posesiones de su tío abuelo, entonces, por supuesto, podrá cambiar la forma en que nos dirigimos a usted..."

# game/script.rpy:970
translate es start_fdb24fb5:

    # li "But I fear you will find that those in your Great Uncles employ are... enthusiastic... about the prospect of you as our new lord."
    li "Pero me temo que descubrirá que quienes trabajaban para su tío abuelo están... entusiasmados... con la idea de tenerlo como nuestro nuevo señor."

# game/script.rpy:972
translate es start_3f9fb7bb:

    # li "You will have to forgive a certain amount of respect and subservience."
    li "Tendrá que perdonar cierta cantidad de respeto y sumisión."

# game/script.rpy:976
translate es start_156f27ec:

    # x "I’m sorry,"
    x "Perdón,"

# game/script.rpy:978
translate es start_b12e3120:

    # x "What is all this about?"
    x "¿De qué se trata todo esto?"

# game/script.rpy:986
translate es start_ae41706c:

    # l "Let me explain,"
    l "Déjeme explicarle,"

# game/script.rpy:988
translate es start_b853bbd9:

    # "{i}~I felt a shiver down my spine at her voice, so sexy and powerful was it~"
    "{i}~Sentí un escalofrío por la espalda al oír su voz, tan sexy y poderosa era~"

# game/script.rpy:990
translate es start_c1138555:

    # l "Your Great Uncle was one of a long line that stretches back for generation to before the birth of this nation."
    l "Su tío abuelo formaba parte de un largo linaje que se remonta por generaciones hasta antes del nacimiento de esta nación."

# game/script.rpy:999
translate es start_4091d6b7:

    # l "He was of your family but at the same time not."
    l "Era de su familia, pero al mismo tiempo no."

# game/script.rpy:1001
translate es start_56fc76a8:

    # "{i}~She saw my confused look and smiled~"
    "{i}~Vio mi expresión de confusión y sonrió~"

# game/script.rpy:1003
translate es start_6ec450d6:

    # l "You see, each Lord of Starmount is chosen by the previous Lord."
    l "Verás, cada Lord de Starmount es elegido por el Lord anterior."

# game/script.rpy:1005
translate es start_2f58a862:

    # l "Your great Uncle was given the responsibility and honor of ruling the estate by his grandfather, chosen over twenty-two other male relative."
    l "Tu tío abuelo recibió la responsabilidad y el honor de gobernar la finca de manos de su abuelo, elegido por encima de otros veintidós parientes varones."

# game/script.rpy:1007
translate es start_a1bccfe9:

    # l "Your Great Uncle chose you, out of the nineteen other males of the Sussex line, spread out around the world."
    l "Tu tío abuelo te eligió a ti, entre los otros diecinueve varones de la línea Sussex, repartidos por todo el mundo."

# game/script.rpy:1016
translate es start_286742bb:

    # x "Why me?{size=26}{i}{color=#A9A9A9}~feeling lost and grateful to my crazy old uncle~"
    x "¿Por qué yo?{size=26}{i}{color=#A9A9A9}~sintiéndome perdido y agradecido con mi loco tío viejo~"

# game/script.rpy:1020
translate es start_4af10e8e:

    # l "That has to do with the nature of tests you were given as a boy from your Great Uncle."
    l "Eso tiene que ver con la naturaleza de las pruebas que tu tío abuelo te puso cuando eras niño."

# game/script.rpy:1022
translate es start_764fe902:

    # l "Your name was given to us during Christmas of your eleventh year. We have been preparing for your ascension ever since."
    l "Nos dieron tu nombre en la Navidad de cuando cumpliste once años. Desde entonces nos hemos estado preparando para tu ascenso."

# game/script.rpy:1030
translate es start_61740c84:

    # x "Ascension? What am I becoming, a king?"
    x "¿Ascenso? ¿En qué me voy a convertir, en un rey?"

# game/script.rpy:1032
translate es start_7de026e4:

    # "{i}~I laughed at the absurdity of it, but my laughter died off as I saw the two women glance at one another~"
    "{i}~Me reí de lo absurdo que era, pero mi risa se apagó cuando vi que las dos mujeres se miraban entre sí~"

# game/script.rpy:1041
translate es start_00ac4889:

    # l "In a way...yes, you will be."
    l "En cierto modo... sí, lo serás."

# game/script.rpy:1043
translate es start_4dca84ef:

    # l "Once you sign these papers you will be the Lord of Starmount, and rights holder to all that seat entails."
    l "En cuanto firmes estos papeles serás el Lord de Starmount, y titular de todos los derechos que ese cargo conlleva."

# game/script.rpy:1045
translate es start_fc2422c1:

    # l "The lands you will lay claim to are matched only by the Crown of England itself, you will no longer be only a citizen of the United States, you will be the ruler of an autonomous protectorate."
    l "Las tierras que reclamarás solo se comparan con las de la propia Corona de Inglaterra. Ya no serás solo un ciudadano de los Estados Unidos, serás el gobernante de un protectorado autónomo."

# game/script.rpy:1047
translate es start_cc0872b2:

    # l "In secret court filings written by John Jay and James Madison, before the founding of the Republic, your ancestors were provided special dispensation, though that secret remains to this day."
    l "En documentos judiciales secretos escritos por John Jay y James Madison, antes de la fundación de la República, a tus ancestros se les concedió una dispensa especial, aunque ese secreto se mantiene hasta el día de hoy."

# game/script.rpy:1056
translate es start_fa100920:

    # li "What she means,{size=26}{i}{color=#A9A9A9}~Linda said with a sexy voice~"
    li "Lo que quiere decir es,{size=26}{i}{color=#A9A9A9}~dijo Linda con una voz sexy~"

# game/script.rpy:1058
translate es start_115fda1b:

    # li "Is the government will never interfere with how you run your lands or how you chose to govern your people."
    li "Que el gobierno nunca interferirá en cómo administras tus tierras ni en cómo decides gobernar a tu gente."

# game/script.rpy:1060
translate es start_186cf381:

    # x "Why?{size=26}{i}{color=#A9A9A9}~I asked, the first of a hundred more I wanted to ask them~"
    x "¿Por qué?{size=26}{i}{color=#A9A9A9}~pregunté, la primera de cien preguntas más que quería hacerles~"

# game/script.rpy:1069
translate es start_e887aec5:

    # l "That is because of the work your Great Uncle and those before him have been working on, work he has groomed you to continue."
    l "Eso se debe al trabajo en el que tu tío abuelo y quienes vinieron antes que él han estado trabajando, un trabajo para el que él te ha estado preparando para que continúes."

# game/script.rpy:1078
translate es start_13439b9a:

    # "{i}~Lisa pulled out a book from the bottom of the stack and handed it over~"
    "{i}~Lisa sacó un libro del fondo de la pila y me lo entregó~"

# game/script.rpy:1080
translate es start_78e6d9c1:

    # l "We were told to let you read through your Great Uncles notes before you decided anything. He wanted you to be fully informed of the task ahead."
    l "Nos dijeron que te dejáramos leer las notas de tu tío abuelo antes de que decidieras algo. Él quería que estuvieras plenamente informado de la tarea que te espera."

# game/script.rpy:1085
translate es start_061a9ec7:

    # "{i}~Intrigued, I took the book and opened it. I was soon lost in the diagrams and notes that had been left in the first section~"
    "{i}~Intrigado, tomé el libro y lo abrí. Pronto me perdí en los diagramas y notas que había en la primera sección~"

# game/script.rpy:1087
translate es start_ebe1fa0e:

    # "{i}~There was no written note laying out what he had been working on, but that made sense~"
    "{i}~No había ninguna nota escrita que explicara en qué había estado trabajando, pero eso tenía sentido~"

# game/script.rpy:1089
translate es start_2df01988:

    # "{i}~Something this complicated could be explained so much quicker to a technical mind through test results and mechanical drawings~"
    "{i}~Algo tan complicado se podía explicar mucho más rápido a una mente técnica mediante resultados de pruebas y dibujos mecánicos~"

# game/script.rpy:1091
translate es start_fcf9a307:

    # x "But this is..."
    x "Pero esto es..."

# game/script.rpy:1094
translate es start_5f03aada:

    # "{i}~I flipped through more pages, stunned at what I was reading~"
    "{i}~Pasé más páginas, atónito ante lo que estaba leyendo~"

# game/script.rpy:1096
translate es start_5176cc1e:

    # x "This is impossible..."
    x "Esto es imposible..."

# game/script.rpy:1104
translate es start_31b6372b:

    # li "I assure you, Young Master, all the Lords of Starmount have been driven by the same task."
    li "Te aseguro, joven amo, que a todos los Lords de Starmount los ha impulsado la misma tarea."

# game/script.rpy:1106
translate es start_a07988da:

    # li "One your government has been aware of and quietly encouraging. Although it is entirely self-funded and free from any outside influence."
    li "Una que tu gobierno conoce y ha estado alentando en silencio. Aunque se financia por completo por sí misma y está libre de cualquier influencia externa."

# game/script.rpy:1108
translate es start_74f3f875:

    # x "It bases this on Nikola Tesla's theory of free energy transmission and generation."
    x "Se basa en la teoría de Nikola Tesla sobre la transmisión y generación de energía libre."

# game/script.rpy:1110
translate es start_6db87df2:

    # x "From the looks of this his initial research has been progressed over at least a century."
    x "A juzgar por esto, su investigación inicial ha avanzado durante al menos un siglo."

# game/script.rpy:1119
translate es start_0ba4621f:

    # l "Ahh,"
    l "Ahh,"

# game/script.rpy:1121
translate es start_bdc3afa1:

    # l "In truth the research that was stolen from your Great, Great, Great Grandfather was used by Nikola Tesla, to further his own theories."
    l "En verdad, la investigación que le robaron a tu tataratatarabuelo fue usada por Nikola Tesla para desarrollar sus propias teorías."

# game/script.rpy:1123
translate es start_70425a56:

    # x "These are devices and cables that can transmit electricity without loss if I read these calculations properly...wires with no resistance...why have I never heard of such products?"
    x "Estos son dispositivos y cables que pueden transmitir electricidad sin pérdidas, si leo bien estos cálculos... cables sin resistencia... ¿por qué nunca he oído hablar de productos así?"

# game/script.rpy:1132
translate es start_60828b7a:

    # "{i}~The two women glanced up and behind them to an ancient plaque on the wall. On it was a quote, engraved into a copper plate that had been buffed to a brilliant shine. It read:~"
    "{i}~Las dos mujeres miraron hacia arriba y detrás de ellas, a una antigua placa en la pared. En ella había una cita, grabada en una placa de cobre pulida hasta sacarle un brillo espectacular. Decía:~"

# game/script.rpy:1134
translate es start_5b060b68:

    # "{i}~A Warm Light For All Mankind~"
    "{i}~Una luz cálida para toda la humanidad~"

# game/script.rpy:1136
translate es start_4bd73800:

    # "{i}~I knew the answer without them having to say anything~"
    "{i}~Supe la respuesta sin que tuvieran que decir nada~"

# game/script.rpy:1140
translate es start_6624ebc4:

    # "{i}~Flipping through the book, I found a section that talks about a hypothesized type of nuclear reaction~"
    "{i}~Hojeando el libro, encontré una sección que habla de un tipo hipotético de reacción nuclear~"

# game/script.rpy:1142
translate es start_0227b5f5:

    # x "A form of Cold Fusion...{size=26}{i}{color=#A9A9A9}~I breathed~"
    x "Una forma de fusión fría...{size=26}{i}{color=#A9A9A9}~susurré~"

# game/script.rpy:1144
translate es start_4c0fae33:

    # x "A final answer to the energy problem of humanity..."
    x "Una respuesta final al problema energético de la humanidad..."

# game/script.rpy:1146
translate es start_31eac6e9:

    # x "But how has it been kept secret for so long? The amount of research and experimentations that must have been done to get this close."
    x "Pero ¿cómo se ha mantenido en secreto tanto tiempo? La cantidad de investigación y experimentación que debe haberse hecho para llegar tan cerca."

# game/script.rpy:1154
translate es start_72270630:

    # li "Now you see the wisdom in your ancestor carving out a special dispensation from the founders of this nation.{size=26}{i}{color=#A9A9A9}~Linda said, walking over to a small hidden safe door, embedded into the wall~"
    li "Ahora entiendes la sabiduría de tu ancestro al conseguir una dispensa especial de los fundadores de esta nación.{size=26}{i}{color=#A9A9A9}~dijo Linda, caminando hacia una pequeña puerta de caja fuerte oculta, incrustada en la pared~"

# game/script.rpy:1156
translate es start_5758c00a:

    # li "Other than the Chief Justice of the Supreme Court and a few local magistrates, none even know about the extent of the Starmount estate."
    li "Aparte del presidente de la Corte Suprema y unos pocos magistrados locales, nadie conoce siquiera la magnitud de la finca de Starmount."

# game/script.rpy:1160
translate es start_ddfe1a4c:

    # "{i}~She pulled an ancient document, framed in gorilla glass, out of the safe and brought it over for me to read over."
    "{i}~Sacó un documento antiguo, enmarcado en vidrio gorila, de la caja fuerte y me lo trajo para que lo leyera."

# game/script.rpy:1162
translate es start_c84b6ed6:

    # x "Ensuring the independence and special dispensation of our greatest mind, so that a warm light for all mankind can be born in the birthplace of our republic."
    x "Garantizar la independencia y la dispensa especial de nuestra mente más brillante, para que una luz cálida para toda la humanidad pueda nacer en el lugar de nacimiento de nuestra república."

# game/script.rpy:1164
translate es start_234e98c8:

    # x "That handwriting looks familiar."
    x "Esa letra me resulta familiar."

# game/script.rpy:1166
translate es start_3a997e5c:

    # l "I would hope it does."
    l "Esperaría que así fuera."

# game/script.rpy:1168
translate es start_fd634bce:

    # l "It’s the same hand and pen that wrote the Declaration of Independence."
    l "Es la misma mano y la misma pluma que escribieron la Declaración de Independencia."

# game/script.rpy:1176
translate es start_33e56b36:

    # x "What the fuck...{size=26}{i}{color=#A9A9A9}~I breathed, it was all too much~"
    x "¿Qué carajo...?{size=26}{i}{color=#A9A9A9}~susurré, todo era demasiado~"

# game/script.rpy:1178
translate es start_dbe3e966:

    # "{i}~My mind, so happy to work on engineering and math problems all day and ignore the rest of the world, wanted nothing more than to dive into the stack of notes before me~"
    "{i}~Mi mente, tan feliz de trabajar todo el día en problemas de ingeniería y matemáticas e ignorar el resto del mundo, no deseaba nada más que sumergirse en la pila de notas que tenía frente a mí~"

# game/script.rpy:1180
translate es start_770587e2:

    # "{i}~It was a world of research and knowledge that I’d been told my whole life couldn’t possibly exist, and yet here it was~"
    "{i}~Era un mundo de investigación y conocimiento que toda mi vida me habían dicho que no podía existir, y sin embargo ahí estaba~"

# game/script.rpy:1184
translate es start_caa6a9e4:

    # x "So if I take control of my Great Uncle’s estate, I’ll get to work on this?"
    x "Entonces, si tomo el control de la finca de mi tío abuelo, ¿podré trabajar en esto?"

# game/script.rpy:1192
translate es start_e40a40b6:

    # l "Yes!"
    l "¡Sí!"

# game/script.rpy:1194
translate es start_f1418cc3:

    # "{i}~Each was a stunning woman, older, brilliant and self-assured. My whole life women like that had made me nervous and filled me with desire at the same time~"
    "{i}~Cada una era una mujer deslumbrante, mayor, brillante y segura de sí misma. Toda mi vida, las mujeres así me habían puesto nervioso y me habían llenado de deseo al mismo tiempo~"

# game/script.rpy:1196
translate es start_08e047d9:

    # "{i}~I thought I’d buried my MILF obsession years ago, but as the two pretty women gazed at me, I found it come roaring back~"
    "{i}~Creí haber enterrado mi obsesión por las MILF hace años, pero mientras las dos mujeres bonitas me miraban, sentí que volvía con toda su fuerza~"

# game/script.rpy:1205
translate es start_66eec27c:

    # li "There are other...responsibilities that come with being the Lord of Starmount.{size=26}{i}{color=#A9A9A9}~Linda said, and I saw them exchange another look~"
    li "Hay otras... responsabilidades que vienen con ser el Lord de Starmount.{size=26}{i}{color=#A9A9A9}~dijo Linda, y vi que intercambiaban otra mirada~"

# game/script.rpy:1207
translate es start_917da3df:

    # li "You see many have come to believe in the cause your Great Uncle and forbearers have been working on, and have given over their entire lives and...bodies in service to that great task."
    li "Verás, muchos han llegado a creer en la causa en la que tu tío abuelo y tus antepasados han estado trabajando, y han entregado por completo sus vidas y... sus cuerpos al servicio de esa gran tarea."

# game/script.rpy:1209
translate es start_7a09674c:

    # li "The work has remained secret for all these years because the Lords of Starmount have kept themselves isolated, having no wives and never mixing with the rest of the world."
    li "El trabajo se ha mantenido en secreto durante todos estos años porque los Lords de Starmount se han mantenido aislados, sin esposas y sin mezclarse nunca con el resto del mundo."

# game/script.rpy:1211
translate es start_99bce170:

    # li "It is an isolating task and one that requires you to maintain a perfect mental focus for years and years. It is not a thing to be undertaken lightly."
    li "Es una tarea aislante y que requiere que mantengas una concentración mental perfecta durante años y años. No es algo que deba tomarse a la ligera."

# game/script.rpy:1213
translate es start_709dcb29:

    # x "I can never marry?{size=26}{i}{color=#A9A9A9}~feeling like my stomach was falling out of my body~"
    x "¿Nunca podré casarme?{size=26}{i}{color=#A9A9A9}~sintiendo como si se me cayera el estómago~"

# game/script.rpy:1222
translate es start_b52671d2:

    # l "Unfortunately, that is true."
    l "Desafortunadamente, eso es verdad."

# game/script.rpy:1224
translate es start_c1787d32:

    # l "If you chose to accept the terms your Great Uncle set for you then you would never be allowed to marry or give your last name to any of your offspring."
    l "Si decides aceptar los términos que tu tío abuelo estableció para ti, nunca se te permitirá casarte ni dar tu apellido a ninguno de tus hijos."

# game/script.rpy:1226
translate es start_7b36a612:

    # l "There is a clause that allows you to step aside after a year if you find that this life is not for you."
    l "Hay una cláusula que te permite hacerte a un lado después de un año si descubres que esta vida no es para ti."

# game/script.rpy:1230
translate es start_474ee428:

    # "{i}~That should have been enough to turn me away, but honestly, the prospect of never needing to worry about marriage was comforting~"
    "{i}~Eso debería haber bastado para alejarme, pero honestamente, la perspectiva de nunca tener que preocuparme por el matrimonio era reconfortante~"

# game/script.rpy:1232
translate es start_1d40546e:

    # "{i}~I'd never done well with women, always being a bit too awkward and nerdy for them~"
    "{i}~Nunca me había ido bien con las mujeres, siempre había sido un poco demasiado torpe y nerd para ellas~"

# game/script.rpy:1234
translate es start_029049d7:

    # "{i}~I thought back on my Great Uncle and all the small puzzles he had given me in my childhood and the encouraging words about my studies~"
    "{i}~Recordé a mi tío abuelo y todos los pequeños acertijos que me había dado en mi infancia y las palabras de aliento sobre mis estudios~"

# game/script.rpy:1236
translate es start_e4041311:

    # "{i}~I saw now that he had been guiding my education into fields of study that would be most useful to continue the work he had been doing~"
    "{i}~Ahora veía que había estado guiando mi educación hacia los campos de estudio que serían más útiles para continuar el trabajo que él había estado haciendo~"

# game/script.rpy:1238
translate es start_2887cf53:

    # "{i}~I felt such an upwelling of love and respect for the man that my eyes misted slightly~"
    "{i}~Sentí tal oleada de amor y respeto por ese hombre que se me empañaron un poco los ojos~"

# game/script.rpy:1240
translate es start_5585884d:

    # "{i}~My parents had always questioned why the man had never married and settled down, and now I knew the reason because he had devoted his life to a higher cause~"
    "{i}~Mis padres siempre se habían preguntado por qué ese hombre nunca se había casado ni sentado cabeza, y ahora yo sabía la razón: porque había dedicado su vida a una causa superior~"

# game/script.rpy:1242
translate es start_798f35fb:

    # "{i}~I realized my mind was made up, and if my sacrifice was to remain a wifeless virgin my whole life, then so be it~"
    "{i}~Me di cuenta de que ya había tomado mi decisión, y si mi sacrificio era seguir siendo un virgen sin esposa toda mi vida, que así fuera~"

# game/script.rpy:1244
translate es start_db49ea2e:

    # "{i}~At the very least I would be working on the coolest project I could imagine, and if these drawings and notes were any evidence, I could play with some amazing toys and in an amazing lab~"
    "{i}~Al menos estaría trabajando en el proyecto más genial que pudiera imaginar, y si estos dibujos y notas servían de prueba, podría jugar con juguetes increíbles y en un laboratorio increíble~"

# game/script.rpy:1247
translate es start_e1fdb705:

    # x "Ok, I’ll do it."
    x "Está bien, lo haré."

# game/script.rpy:1249
translate es start_4d2d8515:

    # "{i}~The woman smiled broadly and pulled out a few papers~"
    "{i}~La mujer sonrió ampliamente y sacó unos papeles~"

# game/script.rpy:1252
translate es start_73f6ff26:

    # "{i}~They went over the details with me in full, spending a full hour making sure I understood the various clauses~"
    "{i}~Repasaron los detalles conmigo por completo, dedicando una hora entera a asegurarse de que entendiera las distintas cláusulas~"

# game/script.rpy:1260
translate es start_d7c426c3:

    # "{i}~When I finally signed my name on the line they indicated, I saw both women sag and sigh in obvious pleasure~"
    "{i}~Cuando por fin firmé mi nombre en la línea que me indicaron, vi que ambas mujeres se relajaban y suspiraban con evidente placer~"

# game/script.rpy:1269
translate es start_b7d3a4d4:

    # x "Is that all?"
    x "¿Eso es todo?"

# game/script.rpy:1271
translate es start_4153da7d:

    # "{i}~The two women glanced at one another, their cheeks coloring, and then turned bright eyes to me, their lips pressing together in near-identical firm smiles~"
    "{i}~Las dos mujeres se miraron entre sí, con las mejillas sonrojadas, y luego volvieron sus ojos brillantes hacia mí, apretando los labios en sonrisas firmes casi idénticas~"

# game/script.rpy:1280
translate es start_502c086e:

    # li "That is all for today, Young Master, unless there is something you would require from us?"
    li "Eso es todo por hoy, joven amo, a menos que haya algo que requiera de nosotras."

# game/script.rpy:1282
translate es start_d21d69c8:

    # "{i}~Her voice was heated, and I felt instantly nervous as she lifted one red nailed hand to graze soft fingers over the swell of her firm bust~"
    "{i}~Su voz era ardiente, y me sentí nervioso al instante cuando levantó una mano de uñas rojas para rozar con dedos suaves la curva de su busto firme~"

# game/script.rpy:1291
translate es start_989c5ee1:

    # l "Linda!"
    l "¡Linda!"

# game/script.rpy:1293
translate es start_87cb32f7:

    # l "The Young Master has no use for a couple old women like us, let him find new girls for those needs."
    l "El joven amo no tiene necesidad de un par de mujeres viejas como nosotras, déjalo que busque chicas nuevas para esas necesidades."

# game/script.rpy:1302
translate es start_ee7053d2:

    # "{i}~Linda frowned and nodded; her face grew sad, as if she had just lost something she had been desperately hoping for~"
    "{i}~Linda frunció el ceño y asintió; su rostro se entristeció, como si acabara de perder algo que había estado esperando desesperadamente~"

# game/script.rpy:1304
translate es start_60fd530c:

    # "{i}~I was totally lost, my mind still overwhelmed with everything I’d learned~"
    "{i}~Yo estaba totalmente perdido, mi mente todavía abrumada con todo lo que había aprendido~"

# game/script.rpy:1306
translate es start_185e888c:

    # x "Do I just go back to my dorm now?{size=26}{i}{color=#A9A9A9}~kind of at a loss for what to do next and ignoring what I didn’t yet understand~"
    x "¿Simplemente vuelvo a mi dormitorio ahora?{size=26}{i}{color=#A9A9A9}~sin saber muy bien qué hacer después e ignorando lo que aún no entendía~"

# game/script.rpy:1315
translate es start_c283a7dd:

    # l "You are the Lord of Starmount now."
    l "Ahora eres el Lord de Starmount."

# game/script.rpy:1317
translate es start_21c318ed:

    # l "You won’t be living in dorms anymore. We will inform your household staff of the decision and they will be awaiting your arrival at the Manor."
    l "Ya no vivirás en dormitorios. Informaremos al personal de tu casa de la decisión y estarán esperando tu llegada a la Mansión."

# game/script.rpy:1319
translate es start_52dac0ad:

    # l "Do you require anything from your dorm rooms immediately?"
    l "¿Requieres algo de tus dormitorios de inmediato?"

# game/script.rpy:1321
translate es start_b22fd63b:

    # x "No, I guess not right now."
    x "No, supongo que por ahora no."

# game/script.rpy:1330
translate es start_d92878f0:

    # li "Well it was a privilege to meet you, Young Master.{size=26}{i}{color=#A9A9A9}~knuckles white as if she was holding herself back from something~"
    li "Bueno, fue un privilegio conocerte, joven amo.{size=26}{i}{color=#A9A9A9}~con los nudillos blancos, como si se estuviera conteniendo de hacer algo~"

# game/script.rpy:1332
translate es start_15afcd3f:

    # li "I pray we can be of service to you in the future."
    li "Rezo para que podamos servirte en el futuro."

# game/script.rpy:1341
translate es start_56b4cc67:

    # l "Please take this box."
    l "Por favor, toma esta caja."

# game/script.rpy:1343
translate es start_59a1e498:

    # l "It has keys, credit cards, information on the estate's holdings, staff information as well as a list of approved patents that are now held in your name."
    l "Tiene llaves, tarjetas de crédito, información sobre los bienes de la finca, información del personal y también una lista de patentes aprobadas que ahora están a tu nombre."

# game/script.rpy:1345
translate es start_45d4baab:

    # x "Thanks."
    x "Gracias."

# game/script.rpy:1354
translate es start_8984a04b:

    # "{i}~I felt strongly empty-headed, as if I was floating through reality~"
    "{i}~Me sentí con la cabeza totalmente vacía, como si estuviera flotando a través de la realidad~"

# game/script.rpy:1363
translate es start_0d1bbc92:

    # "{i}~I paused and turned back, to find both women watching me with hopeful looks, their hands fidgeting at the buttons of their dresses~"
    "{i}~Me detuve y me volví, para encontrar a ambas mujeres mirándome con expresión esperanzada, jugueteando con las manos en los botones de sus vestidos~"

# game/script.rpy:1365
translate es start_f2194ce2:

    # x "Can I come back if I have any questions? It really was nice talking with you both, I’m sorry I’m just a little overwhelmed right now."
    x "¿Puedo volver si tengo alguna pregunta? De verdad fue agradable hablar con ustedes dos, perdón, es que estoy un poco abrumado en este momento."

# game/script.rpy:1374
translate es start_75ec5a79:

    # l "Of course, you can.{size=26}{i}{color=#A9A9A9}~her smile warm and understanding~"
    l "Por supuesto que puedes.{size=26}{i}{color=#A9A9A9}~su sonrisa cálida y comprensiva~"

# game/script.rpy:1376
translate es start_871662cf:

    # li "You are welcome here anytime, Young Master [x].{size=26}{i}{color=#A9A9A9}~Linda breathed out~"
    li "Eres bienvenido aquí en cualquier momento, joven amo [x].{size=26}{i}{color=#A9A9A9}~suspiró Linda~"

# game/script.rpy:1378
translate es start_71237f2b:

    # li "We will be here...ready and waiting."
    li "Estaremos aquí... listas y esperando."

# game/script.rpy:1382
translate es start_ffc5457b:

    # "{i}~I stepped back out into the hall. My mind going straight to dirty places...~"
    "{i}~Salí de nuevo al pasillo. Mi mente fue directo a lugares sucios...~"

# game/script.rpy:1394
translate es start_28bd035b:

    # "{i}~...as I imagined what those two sexy older women might be like without their posh clothing and perfect demeanor~"
    "{i}~...mientras imaginaba cómo serían esas dos mujeres mayores tan sexys sin su ropa elegante y su porte perfecto~"

# game/script.rpy:1401
translate es start_4a8f243c:

    # "{i}~My nineteen-year-old brain already thinking about sex~"
    "{i}~Mi cerebro de diecinueve años ya estaba pensando en sexo~"

# game/script.rpy:1410
translate es replayscene1_e00925f1:

    # "{i}~I shook my head, driving off the distracting thoughts and found Megan standing in the hallway, hands clasped before herself~"
    "{i}~Sacudí la cabeza, ahuyentando los pensamientos que me distraían, y encontré a Megan parada en el pasillo, con las manos entrelazadas frente a ella~"

# game/script.rpy:1418
translate es replayscene1_4bdb6d30:

    # "{i}~She glanced down and saw the red box in my hands, and her plump lips grew into a big grin~"
    "{i}~Bajó la mirada y vio la caja roja en mis manos, y sus labios carnosos se abrieron en una gran sonrisa~"

# game/script.rpy:1427
translate es replayscene1_a42a2a80:

    # m "Oh, Young Master!"
    m "¡Oh, joven amo!"

# game/script.rpy:1429
translate es replayscene1_12c7794d:

    # m "I am so very happy that you accepted the title."
    m "Estoy muy, muy feliz de que hayas aceptado el título."

# game/script.rpy:1431
translate es replayscene1_50f885c5:

    # "{i}~She glanced up, eyes twinkling as she caught me glancing down her dress~"
    "{i}~Levantó la mirada, con los ojos brillantes al atraparme mirándole el vestido hacia abajo~"

# game/script.rpy:1433
translate es replayscene1_51bfaac1:

    # "{i}~The pale flesh of her plump breasts drew my eyes down into the magical shadows within~"
    "{i}~La piel pálida de sus pechos carnosos atrajo mi mirada hacia las sombras mágicas de su interior~"

# game/script.rpy:1435
translate es replayscene1_f5a1fe5d:

    # x "Thank you, Megan, it’s all rather sudden.{size=26}{i}{color=#A9A9A9}~I said awkwardly~"
    x "Gracias, Megan, todo es bastante repentino.{size=26}{i}{color=#A9A9A9}~dije con torpeza~"

# game/script.rpy:1440
translate es replayscene1_0d49d8a3:

    # "{i}~She turned, still holding my arm and pressing it against her body as she drew me down the hall and to the stairs~"
    "{i}~Se giró, todavía tomándome del brazo y apretándolo contra su cuerpo mientras me guiaba por el pasillo y hacia las escaleras~"

# game/script.rpy:1442
translate es replayscene1_3abe46a7:

    # m "May I ask a question of you, Young Master?"
    m "¿Puedo hacerte una pregunta, joven amo?"

# game/script.rpy:1444
translate es replayscene1_42313dd3:

    # x "Of course."
    x "Claro."

# game/script.rpy:1446
translate es replayscene1_bc0d3398:

    # "{i}~Hoping to be done with it quickly, the pressure of her firm breasts and soft body against my side was driving me crazy~"
    "{i}~Esperando terminar con eso rápido, la presión de sus pechos firmes y su cuerpo suave contra mi costado me estaba volviendo loco~"

# game/script.rpy:1448
translate es replayscene1_dc64d4bc:

    # "{i}~I’d never been so close to a woman as pretty as she was, let alone had one clinging to me~"
    "{i}~Nunca había estado tan cerca de una mujer tan bonita como ella, y mucho menos había tenido a una aferrada a mí~"

# game/script.rpy:1456
translate es replayscene1_523866c3:

    # m "Do you have a girlfriend or lover, currently?"
    m "¿Tienes novia o amante, actualmente?"

# game/script.rpy:1458
translate es replayscene1_4c4b96c5:

    # x "No, I don’t, why?{size=26}{i}{color=#A9A9A9}~I grumbled~"
    x "No, no tengo, ¿por qué?{size=26}{i}{color=#A9A9A9}~refunfuñé~"

# game/script.rpy:1460
translate es replayscene1_1ca4e836:

    # m "That is perfect, Young Master."
    m "Eso es perfecto, joven amo."

# game/script.rpy:1462
translate es replayscene1_b9af4880:

    # m "You see none on the staff were looking forward to the competition."
    m "Verás, nadie del personal esperaba con ganas la competencia."

# game/script.rpy:1464
translate es replayscene1_9220d97a:

    # m "As much as we all love and respect one another, it can get a little catty at times, as I’m sure you could guess..."
    m "Por mucho que todas nos queremos y nos respetamos, a veces puede volverse un poco venenoso, como seguro podrás imaginar..."

# game/script.rpy:1466
translate es replayscene1_c6d4bdb2:

